@using Performance.Domain

<fieldset class="tag-picker"><legend>@T("TagPicker.Tags")</legend>
    <p class="muted tag-hint">@T("TagPicker.Hint")</p>
    @foreach (var group in Groups)
    {
        <div class="tag-category"><span>@group.Label</span><div>
            @foreach (var tag in group.Tags)
            { <button class="secondary-button" type="button" aria-pressed="@(Has(tag) ? "true" : "false")" disabled="@Disabled" @onclick="() => ToggleAsync(tag)">@WorkoutUi.TagName(tag)</button> }
        </div></div>
    }
</fieldset>
<label class="field">@T("TagPicker.Editable")<input aria-label="@T("TagPicker.EditableLabel")" value="@Value" disabled="@Disabled"
    @onchange="args => ValueChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty)" placeholder="@T("TagPicker.Placeholder")" /></label>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    public static (string Label, string[] Tags)[] Groups =>
    [
        (T("TagPicker.Muscle"), ["Pectoraux", "Dos", "Grand dorsal", "Trapèzes", "Épaules", "Biceps", "Triceps", "Quadriceps", "Ischio-jambiers", "Fessiers", "Mollets", "Abdominaux"]),
        (T("TagPicker.Type"), ["Polyarticulaire", "Isolation", "Unilatéral"]),
        (T("TagPicker.Equipment"), ["Machine", "Poulie", "Haltères", "Barre", "Poids du corps"]),
        (T("TagPicker.Movement"), ["Poussée", "Tirage vertical", "Tirage horizontal", "Flexion", "Extension", "Élévation"])
    ];

    public static IReadOnlyList<string> Parse(string value) => value
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .GroupBy(WorkoutUi.NormalizeName).Select(group => group.First()).ToArray();

    public static string Format(IEnumerable<string> tags) => string.Join(", ", tags);

    private bool Has(string tag) => Parse(Value).Any(item => WorkoutUi.NormalizeName(item) == WorkoutUi.NormalizeName(tag));

    private Task ToggleAsync(string tag) => ValueChanged.InvokeAsync(Format(Has(tag)
        ? Parse(Value).Where(item => WorkoutUi.NormalizeName(item) != WorkoutUi.NormalizeName(tag))
        : Parse(Value).Append(tag)));
}
