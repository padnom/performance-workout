@using Performance.Application
@using Performance.Domain
@inject WorkoutStateService State

<article class="panel exercise-card" data-exercise="@Exercise.Id">
    <div class="card-heading">
        <div>
            <p class="eyebrow">@T("ExerciseCard.Eyebrow", Number)</p><h2>@Exercise.Name</h2>
            <p class="muted">@T("ExerciseCard.Summary", WorkoutUi.TagName(ExerciseMuscles.Primary(Exercise)), Plan.RepTarget ?? Exercise.RepTarget, Plan.Rest ?? Exercise.Rest)</p>
            @if (!string.IsNullOrWhiteSpace(Exercise.AlternativeName)) { <p class="machine-name">@T("ExerciseCard.Alternative", Exercise.AlternativeName)</p> }
        </div>
        <button class="secondary-button collapse-exercise" disabled="@_busy" aria-expanded="@(_collapsed ? "false" : "true")" aria-label="@T(_collapsed ? "ExerciseCard.Expand" : "ExerciseCard.Collapse", Exercise.Name)" @onclick="() => _collapsed = !_collapsed">@(_collapsed ? "⌄" : "⌃")</button>
    </div>
    <p class="muted exercise-completion">@T("ExerciseCard.Completion", Rows.Count(WorkoutUi.IsWorkoutSetCompleted), Rows.Count)</p>
    @if (!_collapsed)
    {
    <div class="gym-history">
        <label>@T("ExerciseCard.Gym")
            <select aria-label="@T("ExerciseCard.GymOf", Exercise.Name)" value="@SelectedGym" disabled="@_busy" @onchange="SwitchGymAsync">
                @foreach (var gym in WorkoutUi.ExerciseGyms(Exercise)) { <option value="@gym">@WorkoutUi.GymName(gym)</option> }
            </select>
        </label>
        @if (Exercise.Variants.FirstOrDefault(variant => variant.Gym == SelectedGym)?.MachineName is { Length: > 0 } machine)
        {
            <p class="muted">@machine</p>
        }
        <div class="gym-record"><span>@T("ExerciseCard.GymRecord")</span><strong>@(Record > 0 ? $"{WorkoutUi.Decimal(Record)} kg" : "—")</strong></div>
        @if (History.Any())
        {
            <details>
                <summary>@T("ExerciseCard.LastWorkouts", WorkoutUi.GymName(SelectedGym))</summary>
                @foreach (var item in History.Take(3))
                {
                    <p class="muted">@item.Date.ToLocalTime().ToString("d", DisplayLanguage.Culture) : @HistorySummary(item)</p>
                }
            </details>
        }
    </div>
    <div class="set-grid set-labels"><span>@T("ExerciseCard.SetCol")</span><span>@T("ExerciseCard.LastCol")</span><span>kg</span><span>@T("ExerciseCard.RepsCol")</span><span aria-hidden="true">✓</span><span></span></div>
    @for (var index = 0; index < Rows.Count; index++)
    {
        var setIndex = index;
        var row = Rows[index];
        var previous = Previous.ElementAtOrDefault(index);
        <div class="set-grid set-row @(WorkoutUi.IsWorkoutSetCompleted(row) ? "done" : "")" @key="setIndex">
            <b>@(index + 1)</b><span class="last-cell">@(previous is null ? "—" : $"{previous.Weight}×{previous.Reps}")</span>
            <input inputmode="decimal" aria-label="@T("ExerciseCard.WeightLabel", index + 1, Exercise.Name)" value="@FieldValue(setIndex, TrainingSetField.Weight, row.Weight)" @onchange="args => SaveFieldAsync(setIndex, TrainingSetField.Weight, args.Value?.ToString() ?? string.Empty)" />
            <input inputmode="numeric" aria-label="@T("ExerciseCard.RepsLabel", index + 1, Exercise.Name)" value="@FieldValue(setIndex, TrainingSetField.Reps, row.Reps)" @oninput="args => SaveFieldAsync(setIndex, TrainingSetField.Reps, args.Value?.ToString() ?? string.Empty)" />
            <span class="set-completed" aria-label="@(WorkoutUi.IsWorkoutSetCompleted(row) ? T("ExerciseCard.SetDone") : T("ExerciseCard.SetTodo"))">@(WorkoutUi.IsWorkoutSetCompleted(row) ? "✓" : "○")</span>
            <button class="remove-set" disabled="@(_busy || Rows.Count <= 1)" aria-label="@T("ExerciseCard.RemoveSetLabel", index + 1, Exercise.Name)" @onclick="() => RunAsync(() => State.RemoveSetAsync(Exercise.Id, setIndex))">×</button>
        </div>
    }
    <button class="secondary-button add-set" disabled="@(_busy || Rows.Count >= 20)" aria-label="@T("ExerciseCard.AddSetLabel", Exercise.Name)" @onclick="() => RunAsync(() => State.AddSetAsync(Exercise.Id))">+ @T("ExerciseCard.AddSet")</button>
    @if (State.Data.ActiveWorkout is { RestEnd: { } end } active && active.RestExerciseId == Exercise.Id)
    {
        <div class="mini-rest-timer" role="status">
            <span>@T("ExerciseCard.Rest")</span><strong><LiveTimer Deadline="end" /></strong>
            <button class="secondary-button" disabled="@_busy" aria-label="@T("ExerciseCard.Add30Label", Exercise.Name)" @onclick="() => RunAsync(() => State.ExtendRestAsync())">+30 s</button>
            <button class="secondary-button" disabled="@_busy" aria-label="@T("ExerciseCard.StopTimerLabel", Exercise.Name)" @onclick="() => RunAsync(() => State.StopRestAsync())">×</button>
        </div>
    }
    <div class="exercise-rest-controls">
        <label>@T("ExerciseCard.Rest")<select aria-label="@T("ExerciseCard.RestDurationLabel", Exercise.Name)" value="@RestSeconds" disabled="@_busy" @onchange="ChangeRestAsync">
            @foreach (var seconds in RestOptions) { <option value="@seconds">@FormatDuration(seconds)</option> }
        </select></label>
        <button class="secondary-button rest-button" disabled="@_busy" @onclick="() => RunAsync(() => State.StartRestAsync(Exercise.Id))">@T("ExerciseCard.StartRest")</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(Exercise.Link) && Uri.TryCreate(Exercise.Link, UriKind.Absolute, out var link) && (link.Scheme == "https" || link.Scheme == "http"))
    {
        <a class="action-link" href="@Exercise.Link" target="_blank" rel="noopener noreferrer">@T("ExerciseCard.SeeMovement")</a>
    }
    <div class="exercise-actions">
        <button class="secondary-button replace-exercise" disabled="@_busy" @onclick="() => Replace.InvokeAsync(Exercise)">↻ @T("ExerciseCard.Replace")</button>
        <button class="secondary-button edit-exercise" disabled="@_busy" @onclick="() => Edit.InvokeAsync(Exercise)">✎ @T("ExerciseCard.Edit")</button>
        <button class="danger-button remove-exercise" disabled="@_busy" @onclick="() => Remove.InvokeAsync(Exercise)">@T("ExerciseCard.Remove")</button>
    </div>
    }
</article>

@code {
    [Parameter, EditorRequired] public Exercise Exercise { get; set; } = default!;
    [Parameter, EditorRequired] public WorkoutExercise Plan { get; set; } = default!;
    [Parameter] public int Number { get; set; }
    [Parameter] public EventCallback<string> Error { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback<Exercise> Replace { get; set; }
    [Parameter] public EventCallback<Exercise> Edit { get; set; }
    [Parameter] public EventCallback<Exercise> Remove { get; set; }
    private bool _collapsed;
    private int _pendingOperations;
    private bool _busy => _pendingOperations > 0;
    private long _editRevision;
    private readonly Dictionary<(string Gym, int Index, TrainingSetField Field), (long Revision, string Value)> _pendingValues = new();
    private string SelectedGym => State.GetExerciseGym(Exercise.Id);
    private IReadOnlyList<TrainingSet> Rows => State.GetSets(Exercise.Id);
    private IReadOnlyList<ExerciseHistoryEntry> History => State.GetExerciseHistory(Exercise.Id, SelectedGym);
    private IReadOnlyList<TrainingSet> Previous => State.GetPreviousSets(Exercise.Id, SelectedGym);
    private int RestSeconds => State.GetRestSeconds(Exercise.Id);
    private IEnumerable<int> RestOptions => new[] { 60, 90, 120, 150, 180, RestSeconds }.Distinct().Order();
    private decimal Record => State.GetExerciseRecord(Exercise.Id, SelectedGym) ?? 0;
    private static string FormatDuration(int seconds) => seconds % 60 == 0 ? $"{seconds / 60} min" : $"{seconds / 60} min {seconds % 60:00}";
    private static string HistorySummary(ExerciseHistoryEntry entry) => string.Join(" · ", entry.Performance.Sets.Where(WorkoutUi.HasData).Select(set => $"{set.Weight} kg × {set.Reps}"));
    private string FieldValue(int index, TrainingSetField field, string saved) =>
        _pendingValues.TryGetValue((SelectedGym, index, field), out var pending) ? pending.Value : saved;
    private async Task SaveFieldAsync(int index, TrainingSetField field, string value)
    {
        var gym = SelectedGym;
        var key = (gym, index, field);
        var revision = ++_editRevision;
        _pendingValues[key] = (revision, value);
        _pendingOperations++;
        try
        {
            var result = await State.UpdateSetValueAsync(Exercise.Id, index, field, value, gym);
            await Error.InvokeAsync(result.IsSuccess ? "" : WorkoutUi.Error(result.Error));
        }
        catch { await Error.InvokeAsync(WorkoutUi.Error(null)); }
        finally
        {
            if (_pendingValues.TryGetValue(key, out var pending) && pending.Revision == revision) _pendingValues.Remove(key);
            _pendingOperations--;
            await Changed.InvokeAsync();
        }
    }
    private async Task SwitchGymAsync(ChangeEventArgs args)
    {
        _pendingOperations++;
        try
        {
            var result = await State.SetExerciseGymAsync(Exercise.Id, args.Value?.ToString() ?? "One Air");
            await Error.InvokeAsync(result.IsSuccess ? "" : WorkoutUi.Error(result.Error));
        }
        catch { await Error.InvokeAsync(WorkoutUi.Error(null)); }
        finally { _pendingOperations--; await Changed.InvokeAsync(); }
    }
    private Task ChangeRestAsync(ChangeEventArgs args) => int.TryParse(args.Value?.ToString(), out var seconds)
        ? RunAsync(() => State.SetRestDurationAsync(Exercise.Id, seconds)) : Task.CompletedTask;
    private async Task RunAsync(Func<Task<WorkoutResult>> action)
    {
        _pendingOperations++;
        try
        {
            var result = await action();
            await Error.InvokeAsync(result.IsSuccess ? "" : WorkoutUi.Error(result.Error));
        }
        catch { await Error.InvokeAsync(WorkoutUi.Error(null)); }
        finally { _pendingOperations--; await Changed.InvokeAsync(); }
    }
}
