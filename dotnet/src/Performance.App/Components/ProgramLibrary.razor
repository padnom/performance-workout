@using Performance.Application
@using Performance.Domain
@inject WorkoutStateService State

<section class="program-library" aria-label="Bibliothèque des séances">
    <input class="search-input library-search" type="search" aria-label="Rechercher une séance" placeholder="Rechercher : push, dos, presse…"
        value="@_search" @oninput="args => _search = args.Value?.ToString() ?? string.Empty" />
    <div class="library-filters" role="group" aria-label="Filtrer les séances">
        @foreach (var filter in Filters)
        {
            <button type="button" class="secondary-button library-filter" data-filter="@filter.Key" aria-pressed="@Pressed(_filter == filter.Key)" disabled="@Disabled" @onclick="() => _filter = filter.Key">@filter.Label</button>
        }
    </div>
    @{ var groups = VisibleGroups().ToArray(); }
    @if (groups.Length == 0)
    {
        <p class="muted library-empty">@EmptyMessage</p>
    }
    @foreach (var (group, sessions) in groups)
    {
        <section class="library-group" data-group="@group.Program.Id" @key="group.Program.Id">
            <div class="library-group-heading">
                <h2>@group.Name</h2>
                <ProgramFavoriteButton Snapshot="State.Data" ProgramId="@group.Program.Id" ProgramName="@group.Name" Disabled="Disabled" Changed="Changed" />
            </div>
            @foreach (var session in sessions)
            {
                <div class="library-row" data-session="@session.Id" @key="session.Id">
                    <button type="button" class="library-open" disabled="@Disabled" aria-label="Afficher @session.Name" @onclick="() => Selected.InvokeAsync(session)">
                        <strong>@session.Name</strong><small>@Summary(session)</small>
                    </button>
                    <button type="button" class="secondary-button library-start" disabled="@Disabled" aria-label="Démarrer @session.Name" @onclick="() => Started.InvokeAsync(session)"><span aria-hidden="true">▶&#xFE0E;</span></button>
                </div>
            }
        </section>
    }
</section>

@code {
    [Parameter] public EventCallback<WorkoutSession> Selected { get; set; }
    [Parameter] public EventCallback<WorkoutSession> Started { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public PerformanceData? Snapshot { get; set; }
    [Parameter] public bool Disabled { get; set; }

    public const string AllFilter = "all", FavoritesFilter = "favorites", MineFilter = "mine", GymFilter = "gym", ClassicFilter = "classic", TargetedFilter = "targeted";
    private static readonly HashSet<string> ClassicIds = ["push", "pull", "legs", "upper", "arms", "full"];
    private static readonly HashSet<string> TargetedIds = ["chest-biceps", "back-triceps", "chest-back", "quads-calves", "hams-glutes"];
    private static readonly HashSet<string> HiddenIds = ["react-week-plan", "gym-one-air", "gym-basic-fit"];
    private string _filter = AllFilter;
    private string _search = "";

    public sealed record LibraryGroup(WorkoutProgram Program, string Name, string Family, IReadOnlyList<WorkoutSession> Sessions);

    /// <summary>
    /// Every startable session, grouped by program: personal programs first, then the recommended program of the current gym,
    /// then the classic and targeted families. The weekly plan stays stored but is no longer shown.
    /// </summary>
    public static IReadOnlyList<LibraryGroup> Groups(WorkoutStateService state)
    {
        var programs = state.Programs;
        var mine = programs.Where(program => !HiddenIds.Contains(program.Id) && !ClassicIds.Contains(program.Id) && !TargetedIds.Contains(program.Id))
            .Select(program => new LibraryGroup(program, program.Name, MineFilter, program.Sessions));
        var gym = state.GetRecommendedProgram(state.CurrentGym) is { } recommended
            ? [new LibraryGroup(recommended, $"Programme {WorkoutUi.GymName(recommended.Gym)}", GymFilter, recommended.Sessions)]
            : Array.Empty<LibraryGroup>();
        var families = programs.Where(program => ClassicIds.Contains(program.Id) || TargetedIds.Contains(program.Id))
            .OrderBy(program => TargetedIds.Contains(program.Id))
            .Select(program => new LibraryGroup(program, program.Name, ClassicIds.Contains(program.Id) ? ClassicFilter : TargetedFilter, VariantsFor(program)));
        return mine.Concat(gym).Concat(families).Where(group => group.Sessions.Count > 0).ToArray();
    }

    /// <summary>Built-in families keep a base session named like the program; only its variants are offered.</summary>
    public static IReadOnlyList<WorkoutSession> VariantsFor(WorkoutProgram program) => ClassicIds.Contains(program.Id) || TargetedIds.Contains(program.Id)
        ? program.Sessions.Where(session => session.Id != program.Id).ToArray()
        : program.Sessions;

    private IEnumerable<(string Key, string Label)> Filters
    {
        get
        {
            yield return (AllFilter, "Tous");
            yield return (FavoritesFilter, "★ Favoris");
            yield return (MineFilter, "Mes séances");
            if (State.GetRecommendedProgram(State.CurrentGym) is { } program) yield return (GymFilter, WorkoutUi.GymName(program.Gym));
            yield return (ClassicFilter, "Classiques");
            yield return (TargetedFilter, "Ciblées");
        }
    }

    private IEnumerable<(LibraryGroup Group, WorkoutSession[] Sessions)> VisibleGroups()
    {
        var favorites = State.FavoritePrograms.Select(program => program.Id).ToHashSet(StringComparer.Ordinal);
        var search = WorkoutUi.NormalizeName(_search);
        foreach (var group in Groups(State))
        {
            if (!MatchesFilter(group, favorites)) continue;
            var sessions = group.Sessions.Where(session => search.Length == 0 || SearchText(group, session).Contains(search, StringComparison.Ordinal)).ToArray();
            if (sessions.Length > 0) yield return (group, sessions);
        }
    }

    private bool MatchesFilter(LibraryGroup group, HashSet<string> favorites) => _filter switch
    {
        AllFilter => true,
        FavoritesFilter => favorites.Contains(group.Program.Id),
        _ => group.Family == _filter
    };

    private string SearchText(LibraryGroup group, WorkoutSession session) => WorkoutUi.NormalizeName(string.Join(' ',
        new[] { group.Name, session.Name, session.Focus ?? "" }.Concat(Definitions(session).SelectMany(exercise => exercise.Tags.Append(exercise.Name)))));

    private IEnumerable<Exercise> Definitions(WorkoutSession session) => session.Exercises
        .Select(plan => State.AllExercises.FirstOrDefault(exercise => exercise.Id == plan.ExerciseId)).OfType<Exercise>();

    private string Summary(WorkoutSession session)
    {
        var muscles = Definitions(session).Select(ExerciseMuscles.Primary).Where(muscle => muscle.Length > 0).Distinct().Take(3);
        return string.Join(" · ", muscles.Append($"{session.Exercises.Count} exercices"));
    }

    private string EmptyMessage => _filter == FavoritesFilter && _search.Length == 0
        ? "Aucun favori pour l’instant. Touche l’étoile d’un programme pour le retrouver ici."
        : "Aucune séance ne correspond. Essaie un autre mot ou un autre filtre.";

    private static string Pressed(bool selected) => selected ? "true" : "false";
}
