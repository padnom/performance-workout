@using Performance.App.Services
<section class="update-banner" role="status" aria-label="@T("Update.Aria")">
    <div>
        <strong>@T("Update.NewVersion", Updates.Available?.Version)</strong>
        <span>@(Updates.Status == AppUpdateStatus.Downloading ? T("Update.Downloading", Updates.Progress) : Updates.Message)</span>
        @if (Updates.Status == AppUpdateStatus.Downloading) { <span class="update-progress"><span style="width: @((Updates.Progress * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></span></span> }
    </div>
    <div class="update-actions">
        <button class="primary-button" disabled="@Updates.Busy" @onclick="InstallAsync">@(Updates.Status == AppUpdateStatus.PermissionRequired ? T("Update.Retry") : T("Update.Install"))</button>
        <button class="secondary-button" disabled="@Updates.Busy" @onclick="Updates.Dismiss">@T("Update.Later")</button>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public AppUpdateService Updates { get; set; } = default!;
    private Task InstallAsync() => Updates.InstallAsync();
}
