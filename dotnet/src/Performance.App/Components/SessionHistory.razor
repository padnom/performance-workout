@using Performance.Application
@using Performance.Domain
@using Performance.App.Services
@inject WorkoutStateService State
@inject IServiceProvider Services

<div class="card-list">
    @foreach (var log in Logs)
    {
        var performances = Performances(log).ToArray();
        <section class="panel history-card" @key="log.Id">
            <div class="card-heading">
                <div><p class="eyebrow">@log.Date.ToLocalTime().ToString("dd/MM/yyyy · HH:mm")</p><h2>@SessionName(log)</h2></div>
                <span class="count">@log.DurationMinutes min</span>
            </div>
            <p class="muted">@performances.Length exercice(s) · @performances.SelectMany(performance => performance.Sets).Count(set => WorkoutUi.Number(set.Reps) > 0) séries</p>
            <details>
                <summary>Voir les séries</summary>
                @foreach (var performance in performances)
                {
                    <div class="history-exercise">
                        <h3>@ExerciseName(performance.ExerciseId) <small>· @WorkoutUi.Gym(performance)</small></h3>
                        <div class="history-set-header"><span>Série</span><span>kg</span><span>Reps</span></div>
                        @foreach (var item in performance.Sets.Select((set, index) => new { Set = set, Index = index }).Where(item => HasData(item.Set)))
                        {
                            <div class="history-set">
                                <b>@(item.Index + 1)</b>
                                <span>@Value(item.Set.Weight)</span>
                                <span>@Value(item.Set.Reps)</span>
                            </div>
                        }
                    </div>
                }
            </details>
            @if (Replay.HasDelegate)
            {
                <div class="settings-actions">
                    <button class="primary-button replay-session" data-log="@log.Id" disabled="@(_busy || State.Data.ActiveWorkout is not null)" @onclick="() => ReplayAsync(log)">Refaire cette séance</button>
                </div>
                @if (State.Data.ActiveWorkout is not null) { <p class="muted replay-blocked">Termine d’abord la séance en cours pour la refaire.</p> }
            }
            <div class="settings-actions">
                <button class="secondary-button export-session" data-log="@log.Id" disabled="@_busy" @onclick="() => ShareAsync(log, Sharer.ShareFileAsync)">Exporter la séance</button>
                <button class="secondary-button share-session-text" data-log="@log.Id" disabled="@_busy" @onclick="() => ShareAsync(log, Sharer.ShareTextAsync)">Partager en texte</button>
            </div>
            @if (_messageLogId == log.Id && _message.Length > 0) { <p class="notice" role="status">@_message</p> }
        </section>
    }
</div>
@if (!Logs.Any())
{
    <section class="panel empty-state"><div class="empty-icon">◷</div><h3>Aucune séance enregistrée</h3><p class="muted">Termine une séance ou importe ta sauvegarde depuis les réglages pour retrouver ton historique.</p></section>
}

@code {
    [Parameter] public string Gym { get; set; } = "";
    [Parameter] public int? RecentLimit { get; set; }
    [Parameter] public EventCallback<WorkoutSession> Replay { get; set; }

    private bool _busy;
    private string _message = "";
    private string _messageLogId = "";

    private IEnumerable<TrainingSessionLog> Logs
    {
        get
        {
            var history = State.Data.History.Reverse()
                .Where(log => string.IsNullOrEmpty(Gym) || log.Exercises.Any(performance => WorkoutUi.Gym(performance) == Gym))
                .OrderByDescending(log => log.Date);
            return RecentLimit is > 0 ? history.Take(RecentLimit.Value) : history;
        }
    }
    private IEnumerable<ExercisePerformance> Performances(TrainingSessionLog log) => log.Exercises
        .Where(performance => string.IsNullOrEmpty(Gym) || WorkoutUi.Gym(performance) == Gym);
    private string SessionName(TrainingSessionLog log) => string.IsNullOrWhiteSpace(log.Name) ? SessionName(log.SessionId) : log.Name.Trim();
    private string SessionName(string id) => State.Programs.SelectMany(program => program.Sessions)
        .FirstOrDefault(session => session.Id == id)?.Name ?? (id == "free" ? "Séance libre" : "Séance");
    private string ExerciseName(string id) => State.AllExercises.FirstOrDefault(exercise => exercise.Id == id)?.Name ?? "Exercice inconnu";
    private WorkoutSession ExportSession(TrainingSessionLog log) => SessionFromLog(log, $"{SessionName(log)} · {log.Date.ToLocalTime():dd/MM}");
    private WorkoutSession SessionFromLog(TrainingSessionLog log, string name)
    {
        var planned = State.Programs.SelectMany(program => program.Sessions).FirstOrDefault(session => session.Id == log.SessionId);
        return SessionExport.FromLog(log, planned, name, State.AllExercises);
    }
    private async Task ReplayAsync(TrainingSessionLog log)
    {
        if (_busy || State.Data.ActiveWorkout is not null) return;
        _messageLogId = log.Id; _message = "";
        WorkoutSession session;
        try { session = SessionFromLog(log, SessionName(log)); }
        catch (FormatException) { _message = "Cette séance ne peut pas être refaite : ses exercices n’existent plus."; return; }
        await Replay.InvokeAsync(session);
    }
    private async Task ShareAsync(TrainingSessionLog log, Func<Func<WorkoutSession>, Task<string>> share)
    {
        if (_busy) return;
        _busy = true; _messageLogId = log.Id; _message = "";
        try { _message = await share(() => ExportSession(log)); }
        finally { _busy = false; }
    }
    private SessionSharer Sharer => new(Services, State);
    private static bool HasData(TrainingSet set) => WorkoutUi.HasData(set);
    private static string Value(string text) => string.IsNullOrWhiteSpace(text) ? "—" : text;
}
