@using Performance.Application
@using Performance.Domain
@using Performance.App.Services
@inject WorkoutStateService State
@inject IServiceProvider Services

<div class="card-list">
    @{ var favorites = State.FavoriteSessionIds; }
    @foreach (var log in Logs)
    {
        var favorite = favorites.Contains(FavoriteTarget(log));
        var performances = Performances(log).ToArray();
        <section class="panel history-card" @key="log.Id">
            <div class="card-heading">
                <div><p class="eyebrow">@log.Date.ToLocalTime().ToString(T("SessionHistory.DateTimeFormat"), DisplayLanguage.Culture)</p><h2>@DisplayName(log)</h2></div>
                <span class="count">@T("SessionHistory.Minutes", log.DurationMinutes)</span>
                <button type="button" class="secondary-button session-favorite" data-favorite-log="@log.Id" aria-pressed="@(favorite ? "true" : "false")" aria-label="@(favorite ? T("Favorite.Remove", DisplayName(log)) : T("Favorite.Add", DisplayName(log)))" disabled="@_busy" @onclick="() => ToggleFavoriteAsync(log)"><span aria-hidden="true">@(favorite ? "★" : "☆")</span></button>
            </div>
            <p class="muted">@T("SessionHistory.Summary", performances.Length, performances.SelectMany(performance => performance.Sets).Count(set => WorkoutUi.Number(set.Reps) > 0))</p>
            <details>
                <summary>@T("SessionHistory.ShowSets")</summary>
                @foreach (var performance in performances)
                {
                    <div class="history-exercise">
                        <h3>@ExerciseName(performance.ExerciseId) <small>· @WorkoutUi.GymName(WorkoutUi.Gym(performance))</small></h3>
                        <div class="history-set-header"><span>@T("SessionHistory.SetColumn")</span><span>@T("SessionHistory.Weight")</span><span>@T("SessionHistory.Reps")</span></div>
                        @foreach (var item in performance.Sets.Select((set, index) => new { Set = set, Index = index }).Where(item => HasData(item.Set)))
                        {
                            <div class="history-set">
                                <b>@(item.Index + 1)</b>
                                <span>@Value(item.Set.Weight)</span>
                                <span>@Value(item.Set.Reps)</span>
                            </div>
                        }
                    </div>
                }
            </details>
            @if (Replay.HasDelegate)
            {
                <div class="settings-actions">
                    <button class="primary-button replay-session" data-log="@log.Id" disabled="@(_busy || State.Data.ActiveWorkout is not null)" @onclick="() => ReplayAsync(log)">@T("SessionHistory.Replay")</button>
                </div>
                @if (State.Data.ActiveWorkout is not null) { <p class="muted replay-blocked">@T("SessionHistory.ReplayBlocked")</p> }
            }
            <div class="settings-actions">
                <button class="secondary-button export-session" data-log="@log.Id" disabled="@_busy" @onclick="() => ShareAsync(log, Sharer.ShareFileAsync)">@T("SessionHistory.Export")</button>
                <button class="secondary-button share-session-text" data-log="@log.Id" disabled="@_busy" @onclick="() => ShareAsync(log, Sharer.ShareTextAsync)">@T("SessionHistory.ShareText")</button>
            </div>
            @if (_messageLogId == log.Id && _message.Length > 0) { <p class="notice" role="status">@_message</p> }
        </section>
    }
</div>
@if (!Logs.Any())
{
    <section class="panel empty-state"><div class="empty-icon">◷</div><h3>@T("SessionHistory.EmptyTitle")</h3><p class="muted">@T("SessionHistory.EmptyHint")</p></section>
}

@code {
    [Parameter] public string Gym { get; set; } = "";
    [Parameter] public int? RecentLimit { get; set; }
    [Parameter] public EventCallback<WorkoutSession> Replay { get; set; }

    private bool _busy;
    private string _message = "";
    private string _messageLogId = "";

    private IEnumerable<TrainingSessionLog> Logs
    {
        get
        {
            var history = State.Data.History.Reverse()
                .Where(log => string.IsNullOrEmpty(Gym) || log.Exercises.Any(performance => WorkoutUi.Gym(performance) == Gym))
                .OrderByDescending(log => log.Date);
            return RecentLimit is > 0 ? history.Take(RecentLimit.Value) : history;
        }
    }
    private IEnumerable<ExercisePerformance> Performances(TrainingSessionLog log) => log.Exercises
        .Where(performance => string.IsNullOrEmpty(Gym) || WorkoutUi.Gym(performance) == Gym);
    private string SessionName(TrainingSessionLog log) => string.IsNullOrWhiteSpace(log.Name) ? SessionName(log.SessionId) : log.Name.Trim();
    private string SessionName(string id) => State.Programs.SelectMany(program => program.Sessions)
        .FirstOrDefault(session => session.Id == id)?.Name ?? (id == "free" ? "Séance libre" : "Séance");
    private string DisplayName(TrainingSessionLog log) => SessionName(log) switch { "Séance libre" => T("SessionHistory.FreeWorkout"), "Séance" => T("SessionHistory.Workout"), var name => name };
    private string ExerciseName(string id) => State.AllExercises.FirstOrDefault(exercise => exercise.Id == id)?.Name ?? T("SessionHistory.UnknownExercise");
    private WorkoutSession ExportSession(TrainingSessionLog log) => SessionFromLog(log, $"{DisplayName(log)} · {log.Date.ToLocalTime().ToString(T("SessionHistory.ShortDateFormat"), DisplayLanguage.Culture)}");
    private WorkoutSession SessionFromLog(TrainingSessionLog log, string name)
    {
        var planned = State.Programs.SelectMany(program => program.Sessions).FirstOrDefault(session => session.Id == log.SessionId);
        return SessionExport.FromLog(log, planned, name, State.AllExercises);
    }
    private async Task ReplayAsync(TrainingSessionLog log)
    {
        if (_busy || State.Data.ActiveWorkout is not null) return;
        _messageLogId = log.Id; _message = "";
        WorkoutSession session;
        try { session = SessionFromLog(log, SessionName(log)); }
        catch (FormatException) { _message = T("SessionHistory.ReplayFailed"); return; }
        await Replay.InvokeAsync(session);
    }
    /// <summary>The session a history card stars: the one it was done from, or a copy in "Mes séances" when that one can't be a favorite (free workout, week plan, deleted).</summary>
    private string FavoriteTarget(TrainingSessionLog log) => State.CanFavoriteSession(log.SessionId) ? log.SessionId : WorkoutStateService.HistorySessionId(log.Id);
    private async Task ToggleFavoriteAsync(TrainingSessionLog log)
    {
        if (_busy) return;
        _busy = true; _messageLogId = log.Id; _message = "";
        try
        {
            var target = FavoriteTarget(log);
            var exists = State.CanFavoriteSession(target);
            WorkoutResult result;
            if (exists) result = await State.ToggleSessionFavoriteAsync(target);
            else
            {
                WorkoutSession session;
                try { session = ExportSession(log) with { Id = target }; }
                catch (FormatException) { _message = T("SessionHistory.FavoriteFailed"); return; }
                result = await State.FavoriteHistorySessionAsync(session);
            }
            _message = result.IsSuccess
                ? T(!exists ? "SessionHistory.FavoriteSaved" : State.IsSessionFavorite(target) ? "SessionHistory.FavoriteAdded" : "SessionHistory.FavoriteRemoved")
                : WorkoutUi.Error(result.Error);
        }
        catch { _message = WorkoutUi.Error(null); }
        finally { _busy = false; }
    }
    private async Task ShareAsync(TrainingSessionLog log, Func<Func<WorkoutSession>, Task<string>> share)
    {
        if (_busy) return;
        _busy = true; _messageLogId = log.Id; _message = "";
        try { _message = await share(() => ExportSession(log)); }
        finally { _busy = false; }
    }
    private SessionSharer Sharer => new(Services, State);
    private static bool HasData(TrainingSet set) => WorkoutUi.HasData(set);
    private static string Value(string text) => string.IsNullOrWhiteSpace(text) ? "—" : text;
}
