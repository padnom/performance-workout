@using Performance.Application
@using Performance.Domain
@using Performance.App.Services
@implements IDisposable
@inject WorkoutStateService State
@inject IServiceProvider Services

<section class="gym-program" aria-label="Programme par salle">
    <p class="eyebrow">TON PROGRAMME</p>
    <div class="card-heading"><h2>Ton programme — @_gym</h2><select aria-label="Salle du programme" value="@_gym" disabled="@_busy" @onchange="ChangeGym"><option>One Air</option><option>Basic-Fit</option></select></div>
    <p class="muted">4 séances · 4 × 10 · une séance jambes · épaules équilibrées</p>
    @if (_gym == "Basic-Fit") { <p class="muted gym-equipment-note">Matériel standard : remplace explicitement une machine si elle n’est pas disponible dans ta salle.</p> }
    @if (State.GetRecommendedProgram(_gym) is { } program)
    {
        <div class="gym-session-grid">@foreach (var session in program.Sessions)
        {
            <article class="panel gym-session" data-gym-session="@session.Id">
                <div class="card-heading"><h3>@session.Name</h3><button class="secondary-button gym-add-week" aria-label="Ajouter @session.Name à ma semaine" disabled="@_busy" @onclick="() => AddAsync(session.Id)">＋</button></div>
                <p class="muted">@session.Focus</p><small>@session.Exercises.Count exercices · abdos optionnels</small>
                <button class="secondary-button gym-start" disabled="@_busy" @onclick="() => Started.InvokeAsync(session)">Voir la séance →</button>
            </article>
        }</div>
        <button class="primary-button use-gym-week" disabled="@_busy" @onclick="() => _confirm = true">Utiliser cette semaine</button>
    }
    @if (_message.Length > 0) { <p class="notice" role="status">@_message</p> }
</section>
@if (_confirm)
{
    <div class="modal-backdrop"><section class="panel confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="gym-week-title">
        <h2 id="gym-week-title">Utiliser cette semaine — @_gym ?</h2>
        <p class="muted">Les quatre séances remplaceront ta semaine actuelle. Ta séance en cours et ton historique restent conservés.</p>
        @if (_message.Length > 0) { <p class="notice" role="alert">@_message</p> }
        <div class="settings-actions"><button class="primary-button confirm-gym-week" disabled="@_busy" @onclick="ApplyAsync">Confirmer</button><button class="secondary-button" disabled="@_busy" @onclick="() => _confirm = false">Annuler</button></div>
    </section></div>
}

@code {
    [Parameter] public EventCallback<WorkoutSession> Started { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private string _gym = "One Air", _message = "";
    private bool _confirm, _busy;
    private IDisposable? _backRegistration;
    protected override void OnInitialized()
    {
        _gym = State.CurrentGym.Trim() is "Basic-Fit" or "Basic Fit" ? "Basic-Fit" : "One Air";
        if (Services.GetService(typeof(AppNavigationService)) is AppNavigationService navigation) _backRegistration = navigation.RegisterBackHandler(BackAsync, 10);
    }
    private void ChangeGym(ChangeEventArgs args) { _gym = args.Value?.ToString() == "Basic-Fit" ? "Basic-Fit" : "One Air"; _message = ""; }
    private Task AddAsync(string id) => RunAsync(() => State.AddWeekSessionAsync(id), false);
    private Task ApplyAsync() => RunAsync(() => State.UseGymProgramWeekAsync(_gym), true);
    private async Task RunAsync(Func<Task<WorkoutResult>> action, bool close)
    {
        if (_busy) return;
        _busy = true;
        try { var result = await action(); _message = result.IsSuccess ? "" : WorkoutUi.Error(result.Error); if (result.IsSuccess) { if (close) _confirm = false; await Changed.InvokeAsync(); } }
        catch { _message = WorkoutUi.Error(null); }
        finally { _busy = false; }
    }
    private async Task<bool> BackAsync()
    {
        if (!_confirm) return false;
        await InvokeAsync(() => { if (!_busy) _confirm = false; StateHasChanged(); }); return true;
    }
    public void Dispose() => _backRegistration?.Dispose();
}
