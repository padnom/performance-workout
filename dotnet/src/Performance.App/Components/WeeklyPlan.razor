@using Performance.Application
@using Performance.Domain
@inject WorkoutStateService State

<section class="panel week-plan" aria-label="Programme de la semaine">
    <div class="section-heading">
        <div><p class="eyebrow">PROGRAMME ACTIF</p><h2>Ma semaine</h2></div>
        <span class="count">@Sessions.Count séance(s)</span>
    </div>
    @if (Sessions.Count == 0)
    {
        <div class="panel empty-state">
            <h3>Créer ma semaine</h3>
            <p class="muted">Ajoute des séances depuis la bibliothèque ci-dessous, dans l’ordre souhaité. Tu peux choisir plusieurs fois la même séance.</p>
        </div>
    }
    <div class="weekly-list">
        @for (var index = 0; index < Sessions.Count; index++)
        {
            var position = index;
            var session = Sessions[index];
            <article class="weekly-session" @key="position">
                <button class="weekly-start" disabled="@Busy" aria-label="Démarrer la séance @(position + 1) : @session.Name" @onclick="() => Selected.InvokeAsync(session)">
                    <span class="session-index">@((position + 1).ToString("00"))</span>
                    <h3>@session.Name</h3>
                </button>
                <div class="week-actions">
                    <button class="secondary-button week-move-up" disabled="@(Busy || position == 0)" aria-label="Monter la séance @(position + 1)" @onclick="() => RunAsync(() => State.MoveWeekSessionAsync(position, -1))">↑</button>
                    <button class="secondary-button week-move-down" disabled="@(Busy || position == Sessions.Count - 1)" aria-label="Descendre la séance @(position + 1)" @onclick="() => RunAsync(() => State.MoveWeekSessionAsync(position, 1))">↓</button>
                    <button class="secondary-button week-remove" disabled="@Busy" aria-label="Retirer la séance @(position + 1) de ma semaine" @onclick="() => RunAsync(() => State.RemoveWeekSessionAsync(position))">×</button>
                </div>
            </article>
        }
    </div>
</section>

@code {
    [Parameter] public IReadOnlyList<WorkoutSession> Sessions { get; set; } = [];
    [Parameter] public EventCallback<WorkoutSession> Selected { get; set; }
    [Parameter] public EventCallback<string> Error { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private bool _saving;
    private bool Busy => Disabled || _saving;

    private async Task RunAsync(Func<Task<WorkoutResult>> action)
    {
        _saving = true;
        try
        {
            var result = await action();
            await Error.InvokeAsync(result.IsSuccess ? "" : WorkoutUi.Error(result.Error));
        }
        catch { await Error.InvokeAsync(WorkoutUi.Error(null)); }
        finally { _saving = false; }
    }
}
