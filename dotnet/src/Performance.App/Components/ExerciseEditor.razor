@using Performance.Domain
@using Performance.Application
@inject WorkoutStateService State

<div class="modal-backdrop"><section class="panel editor-dialog" role="dialog" aria-modal="true" aria-labelledby="exercise-editor-title">
    <h2 id="exercise-editor-title">@(Original is null ? T("ExerciseEditor.CreateTitle") : T("ExerciseEditor.EditTitle"))</h2>
    <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <label class="field">@T("ExerciseEditor.Name")<input required maxlength="150" aria-label="@T("ExerciseEditor.NameLabel")" @bind="_name" @bind:event="oninput" /></label>
        <div class="field-pair">
            <label class="field">@T("ExerciseEditor.Sets")<input type="number" min="1" max="10" aria-label="@T("ExerciseEditor.SetsLabel")" @bind="_sets" /></label>
            <label class="field">@T("ExerciseEditor.RepTarget")<input aria-label="@T("ExerciseEditor.RepTarget")" @bind="_target" placeholder="8–12" /></label>
        </div>
        <label class="field">@T("ExerciseEditor.RestSeconds")<input type="number" min="15" max="600" aria-label="@T("ExerciseEditor.RestLabel")" @bind="_rest" /></label>
        <label class="field">@T("ExerciseEditor.Link")<input type="url" @bind="_link" placeholder="https://…" /></label>
        <TagPicker @bind-Value="_tags" Disabled="Busy" />
        <fieldset class="gym-checkboxes"><legend>@T("ExerciseEditor.GymsAvailable")</legend>
            @foreach (var gym in WorkoutUi.Gyms)
            { <label><input type="checkbox" checked="@_gyms.Contains(gym)" @onchange="() => ToggleGym(gym)" />@WorkoutUi.GymName(gym)</label> }
        </fieldset>
        @if (Original is null && SimilarExercises.Any())
        {
            <aside class="notice duplicate-warning"><strong>@T("ExerciseEditor.SimilarTitle")</strong><p>@T("ExerciseEditor.SimilarHint")</p>
                @foreach (var exercise in SimilarExercises)
                {
                    <button type="button" class="secondary-button use-existing-exercise" disabled="@(Busy || IsAlreadyAdded(exercise))" @onclick="() => ExistingSelected.InvokeAsync(exercise)">
                        <span>@exercise.Name<small>@WorkoutUi.TagName(ExerciseMuscles.Primary(exercise)) · @string.Join(" · ", WorkoutUi.ExerciseGyms(exercise).Select(WorkoutUi.GymName))</small></span><b>@(IsAlreadyAdded(exercise) ? T("ExerciseEditor.AlreadyAdded") : T("ExerciseEditor.Use"))</b>
                    </button>
                }
            </aside>
        }
        @if (_error.Length > 0 || Error.Length > 0) { <p class="notice" role="alert">@(_error.Length > 0 ? _error : Error)</p> }
        <div class="settings-actions">
            <button class="primary-button" type="submit" disabled="@Busy">@(Original is null ? T("ExerciseEditor.CreateAndAdd") : T("ExerciseEditor.SaveChanges"))</button>
            <button class="secondary-button" type="button" disabled="@Busy" @onclick="Cancelled">@T("ExerciseEditor.Cancel")</button>
        </div>
    </form>
</section></div>

@code {
    [Parameter] public Exercise? Original { get; set; }
    [Parameter] public int? SessionSets { get; set; }
    [Parameter] public string? SessionTarget { get; set; }
    [Parameter] public int? SessionRest { get; set; }
    [Parameter] public string DefaultGym { get; set; } = "One Air";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string Error { get; set; } = "";
    [Parameter] public EventCallback<Exercise> Saved { get; set; }
    [Parameter] public EventCallback Cancelled { get; set; }
    [Parameter] public EventCallback<Exercise> ExistingSelected { get; set; }
    private string _name = "", _target = "8–12", _link = "", _tags = "", _error = "";
    private int _sets = 4, _rest = 90;
    private HashSet<string> _gyms = [];
    private IEnumerable<Exercise> SimilarExercises => _name.Trim().Length < 3 ? [] : State.Exercises
        .GroupBy(exercise => WorkoutUi.NormalizeName(exercise.Name)).Select(group => group.First())
        .Select(exercise => (Exercise: exercise, Score: Similarity(_name, exercise.Name)))
        .Where(item => item.Score >= .5).OrderByDescending(item => item.Score).Take(3).Select(item => item.Exercise);
    private bool IsAlreadyAdded(Exercise exercise) => State.Data.ActiveWorkout?.Session?.Exercises.Any(plan =>
        State.AllExercises.FirstOrDefault(item => item.Id == plan.ExerciseId) is { } existing && WorkoutUi.NormalizeName(existing.Name) == WorkoutUi.NormalizeName(exercise.Name)) ?? false;
    protected override void OnInitialized()
    {
        _name = Original?.Name ?? "";
        _sets = SessionSets ?? Original?.Sets ?? 4; _target = SessionTarget ?? Original?.RepTarget ?? "8–12";
        _rest = SessionRest ?? (Original is null ? 90 : WorkoutUi.RestSeconds(Original.Rest));
        _link = Original?.Link ?? ""; _tags = TagPicker.Format(Original is null ? [] : ExerciseMuscles.EditableTags(Original));
        _gyms = Original?.Variants.Count > 0 ? Original.Variants.Select(variant => variant.Gym).ToHashSet() : [DefaultGym];
    }
    private void ToggleGym(string gym) { if (!_gyms.Remove(gym)) _gyms.Add(gym); }
    private static double Similarity(string wanted, string existing)
    {
        if (WorkoutUi.NormalizeName(wanted) == WorkoutUi.NormalizeName(existing)) return 1;
        var wantedTokens = Tokens(wanted); var existingTokens = Tokens(existing);
        return (double)wantedTokens.Intersect(existingTokens).Count() / Math.Max(1, Math.Max(wantedTokens.Count, existingTokens.Count));
    }
    private static HashSet<string> Tokens(string value) => System.Text.RegularExpressions.Regex.Split(value, @"[^\p{L}\p{N}]+")
        .Select(WorkoutUi.NormalizeName).Where(token => token.Length > 2).ToHashSet(StringComparer.Ordinal);
    private async Task SaveAsync()
    {
        if (Busy) return;
        _error = ValidationMessage();
        if (_error.Length > 0) return;
        await Saved.InvokeAsync(Build());
    }
    private string ValidationMessage()
    {
        if (string.IsNullOrWhiteSpace(_name) || !TagPicker.Parse(_tags).Any(ExerciseMuscles.IsMuscle))
            return T("ExerciseEditor.ValidationName");
        if (string.IsNullOrWhiteSpace(_name) || _sets is < 1 or > 10 || _rest is < 15 or > 600 || _gyms.Count == 0)
            return T("ExerciseEditor.ValidationFields");
        if (_link.Length > 0 && (!Uri.TryCreate(_link.Trim(), UriKind.Absolute, out var link) || link.Scheme is not ("https" or "http")))
            return T("ExerciseEditor.ValidationLink");
        return "";
    }
    private Exercise Build() => (Original ?? new Exercise { Id = $"custom-{Guid.NewGuid():N}", Name = _name.Trim(), IsCustom = true }) with
    {
        Name = _name.Trim(), MuscleGroup = ExerciseMuscles.FromTags(TagPicker.Parse(_tags)), Sets = _sets, RepTarget = _target.Trim(),
        Rest = $"{_rest / 60}:{_rest % 60:00}", Link = string.IsNullOrWhiteSpace(_link) ? null : _link.Trim(),
        Tags = TagPicker.Parse(_tags).ToArray(),
        Variants = _gyms.Select(gym => Original?.Variants.FirstOrDefault(variant => variant.Gym == gym) ?? new GymVariant { Gym = gym }).ToArray()
    };
}
