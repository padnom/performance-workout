@implements IDisposable
@using Performance.Application
@using Performance.Domain
@using Performance.App.Services
@inject WorkoutStateService State
@inject NavigationManager Navigation
@inject IServiceProvider Services

@if (_pending is { } session)
{
    var selectedSession = State.ResolveSessionForGym(session, _gym);
    <div class="modal-backdrop"><section class="panel confirm-dialog @(_preview ? "start-preview" : "")" role="dialog" aria-modal="true" aria-labelledby="start-title">
        <div class="card-heading">
            <h2 id="start-title">@(_preview ? session.Name : T("SessionStart.Title"))</h2>
            <button type="button" class="icon-button start-close" aria-label="@T("SessionStart.Back")" title="@T("SessionStart.Back")" disabled="@_busy" @onclick="Close"><Icon Name="close" /></button>
        </div>
        <p class="muted">@(_preview ? session.Focus : T("SessionStart.Hint", session.Name))</p>
        @{
            var canFavorite = _preview && State.CanFavoriteSession(session.Id);
            var canRename = _preview && State.CanRenameSession(session.Id) && !_renaming;
            var canShare = session.Id != "free";
        }
        @if (canFavorite || canRename || canShare)
        {
            var favorite = canFavorite && State.IsSessionFavorite(session.Id);
            var favoriteLabel = favorite ? T("Favorite.Remove", session.Name) : T("Favorite.Add", session.Name);
            <div class="icon-toolbar">
                @if (canFavorite)
                {
                    <div class="icon-tool"><button type="button" class="icon-button session-favorite @(favorite ? "is-on" : "")" aria-pressed="@(favorite ? "true" : "false")" aria-label="@favoriteLabel" title="@favoriteLabel" disabled="@_busy" @onclick="() => ToggleFavoriteAsync(session)"><Icon Name="@(favorite ? "star-filled" : "star")" /></button><span aria-hidden="true">@T("Toolbar.Favorite")</span></div>
                }
                @if (canRename)
                {
                    <div class="icon-tool"><button type="button" class="icon-button rename-session-button" aria-label="@T("SessionStart.Rename")" title="@T("SessionStart.Rename")" disabled="@_busy" @onclick="StartRename"><Icon Name="pencil" /></button><span aria-hidden="true">@T("Toolbar.Rename")</span></div>
                }
                @if (canShare)
                {
                    <div class="icon-tool"><button type="button" class="icon-button export-pending-session" aria-label="@T("SessionStart.Export")" title="@T("SessionStart.Export")" disabled="@_busy" @onclick="() => ShareAsync(selectedSession, Sharer.ShareFileAsync)"><Icon Name="export" /></button><span aria-hidden="true">@T("Toolbar.Export")</span></div>
                    <div class="icon-tool"><button type="button" class="icon-button share-pending-session-text" aria-label="@T("SessionStart.ShareText")" title="@T("SessionStart.ShareText")" disabled="@_busy" @onclick="() => ShareAsync(selectedSession, Sharer.ShareTextAsync)"><Icon Name="text" /></button><span aria-hidden="true">@T("Toolbar.Text")</span></div>
                }
            </div>
        }
        @if (_preview && _renaming && State.CanRenameSession(session.Id))
        {
            <div class="rename-session">
                <label class="field">@T("SessionStart.RenameLabel")<input class="rename-session-input" maxlength="160" @bind="_newName" @bind:event="oninput" @ref="_nameInput" disabled="@_busy" @onkeydown="RenameKeyAsync" /></label>
                <div class="settings-actions">
                    <button class="primary-button rename-session-save" disabled="@_busy" @onclick="SaveRenameAsync">@T("SessionStart.Save")</button>
                    <button class="secondary-button rename-session-cancel" disabled="@_busy" @onclick="CancelRename">@T("SessionStart.Cancel")</button>
                </div>
            </div>
        }
        <label class="field gym-field">@T("SessionStart.GymField")<select @bind="_gym" disabled="@_busy">@foreach (var gym in WorkoutUi.Gyms) { <option value="@gym">@WorkoutUi.GymName(gym)</option> }</select></label>
        @if (_preview)
        {
            <ol>@foreach (var plan in selectedSession.Exercises)
            { <li>@(State.AllExercises.FirstOrDefault(item => item.Id == plan.ExerciseId)?.Name ?? plan.ExerciseId)<span class="muted">@T("SessionStart.PlanLine", plan.Sets ?? 4, plan.RepTarget, plan.Rest)</span></li> }</ol>
            @if (selectedSession.OptionalExercises is { Count: > 0 } optionalExercises) { <p class="muted">@T("SessionStart.OptionalNote", optionalExercises.Count)</p> }
        }
        @if (_message.Length > 0) { <p class="notice" role="alert">@_message</p> }
        <div class="settings-actions">
            <button class="primary-button" disabled="@_busy" @onclick="ConfirmAsync">@(_preview ? T("SessionStart.StartThis") : T("SessionStart.Confirm"))</button>
        </div>
    </section></div>
}

@code {
    [Parameter] public EventCallback Renamed { get; set; }
    [Parameter] public EventCallback FavoriteChanged { get; set; }
    private WorkoutSession? _pending;
    private bool _preview;
    private bool _busy;
    private string _gym = "One Air";
    private string _message = "";
    private bool _renaming;
    private string _newName = "";
    private ElementReference _nameInput;
    private bool _focusName;
    private IDisposable? _backRegistration;
    protected override void OnInitialized()
    {
        if (Services.GetService(typeof(AppNavigationService)) is AppNavigationService navigation)
            _backRegistration = navigation.RegisterBackHandler(HandleBackAsync, 10);
    }
    public void Select(WorkoutSession session, bool confirmOnly = false, bool preferPlanGym = false)
    {
        if (State.Data.ActiveWorkout is not null) return;
        _pending = session;
        var programGym = State.Programs.FirstOrDefault(program => (program.Gym is "One Air" or "Basic-Fit" or "Basic Fit")
            && program.Sessions.Any(candidate => candidate.Id == session.Id))?.Gym;
        var selectedGym = programGym ?? (preferPlanGym ? PlanGym(session) : SessionsProgramGym(session)) ?? State.CurrentGym;
        _gym = selectedGym.Trim() == "Basic Fit" ? "Basic-Fit" : selectedGym;
        _preview = !confirmOnly; _message = ""; _renaming = false;
        StateHasChanged();
    }
    private string? SessionsProgramGym(WorkoutSession session) => State.Programs
        .Any(program => program.Id == WorkoutStateService.SessionsProgramId && program.Sessions.Any(candidate => candidate.Id == session.Id))
        ? PlanGym(session) : null;
    private static string? PlanGym(WorkoutSession session)
    {
        var gyms = session.Exercises.Concat(session.OptionalExercises)
            .Select(plan => plan.Gym is null ? null : ProgramDraft.NormalizeGym(plan.Gym)).Distinct().ToArray();
        return gyms is [("One Air" or "Basic-Fit") and var gym] ? gym : null;
    }
    private async Task ShareAsync(WorkoutSession resolved, Func<Func<WorkoutSession>, Task<string>> share)
    {
        if (_busy) return;
        _busy = true; _message = "";
        try { _message = await share(() => SessionExport.FromPlan(resolved, _gym, State.AllExercises)); }
        finally { _busy = false; }
    }
    private SessionSharer Sharer => new(Services, State);
    private async Task ConfirmAsync()
    {
        if (_preview) { _preview = false; return; }
        if (_pending is null || _busy) return;
        _busy = true;
        try
        {
            var result = await State.StartAsync(_pending, _gym);
            if (!result.IsSuccess) { _message = WorkoutUi.Error(result.Error); return; }
            var free = _pending.Id == "free";
            _pending = null;
            Navigation.NavigateTo(free ? "/seance?ajouter=1" : "/seance");
        }
        catch { _message = WorkoutUi.Error(null); }
        finally { _busy = false; }
    }
    private async Task ToggleFavoriteAsync(WorkoutSession session)
    {
        if (_busy) return;
        _busy = true; _message = "";
        try
        {
            var result = await State.ToggleSessionFavoriteAsync(session.Id);
            if (!result.IsSuccess) { _message = WorkoutUi.Error(result.Error); return; }
            await FavoriteChanged.InvokeAsync();
        }
        catch { _message = WorkoutUi.Error(null); }
        finally { _busy = false; }
    }
    private void StartRename()
    {
        if (_pending is null) return;
        _newName = _pending.Name; _renaming = true; _message = ""; _focusName = true;
    }
    private void CancelRename() { _renaming = false; _message = ""; }
    private async Task RenameKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await SaveRenameAsync();
        else if (args.Key == "Escape") CancelRename();
    }
    private async Task SaveRenameAsync()
    {
        if (_pending is null || _busy) return;
        _busy = true;
        try
        {
            var name = _newName.Trim();
            var result = await State.RenameSessionAsync(_pending.Id, name);
            if (!result.IsSuccess) { _message = WorkoutUi.Error(result.Error); return; }
            _pending = _pending with { Name = name };
            _renaming = false;
            _message = T("SessionStart.Renamed");
            await Renamed.InvokeAsync();
        }
        catch { _message = WorkoutUi.Error(null); }
        finally { _busy = false; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusName) return;
        _focusName = false;
        try { await _nameInput.FocusAsync(); } catch (Exception) { /* focus is a convenience only */ }
    }
    private void Close() { _pending = null; _renaming = false; }
    private async Task<bool> HandleBackAsync()
    {
        if (_pending is null) return false;
        await InvokeAsync(() => { if (!_busy) Close(); StateHasChanged(); });
        return true;
    }
    public void Dispose() => _backRegistration?.Dispose();
}
