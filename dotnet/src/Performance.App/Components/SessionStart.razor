@implements IDisposable
@using Performance.Application
@using Performance.Domain
@using Performance.App.Services
@inject WorkoutStateService State
@inject NavigationManager Navigation
@inject IServiceProvider Services

@if (_pending is { } session)
{
    var selectedSession = State.ResolveSessionForGym(session, _gym);
    <div class="modal-backdrop"><section class="panel confirm-dialog @(_preview ? "start-preview" : "")" role="dialog" aria-modal="true" aria-labelledby="start-title">
        <h2 id="start-title">@(_preview ? session.Name : T("SessionStart.Title"))</h2>
        <p class="muted">@(_preview ? session.Focus : T("SessionStart.Hint", session.Name))</p>
        <label class="field gym-field">@T("SessionStart.GymField")<select @bind="_gym" disabled="@_busy">@foreach (var gym in WorkoutUi.Gyms) { <option value="@gym">@WorkoutUi.GymName(gym)</option> }</select></label>
        @if (_preview)
        {
            <ol>@foreach (var plan in selectedSession.Exercises)
            { <li>@(State.AllExercises.FirstOrDefault(item => item.Id == plan.ExerciseId)?.Name ?? plan.ExerciseId)<span class="muted">@T("SessionStart.PlanLine", plan.Sets ?? 4, plan.RepTarget, plan.Rest)</span></li> }</ol>
            @if (selectedSession.OptionalExercises is { Count: > 0 } optionalExercises) { <p class="muted">@T("SessionStart.OptionalNote", optionalExercises.Count)</p> }
        }
        @if (session.Id != "free")
        {
            <div class="settings-actions">
                <button class="secondary-button export-pending-session" disabled="@_busy" @onclick="() => ShareAsync(selectedSession, Sharer.ShareFileAsync)">@T("SessionStart.Export")</button>
                <button class="secondary-button share-pending-session-text" disabled="@_busy" @onclick="() => ShareAsync(selectedSession, Sharer.ShareTextAsync)">@T("SessionStart.ShareText")</button>
            </div>
        }
        @if (_message.Length > 0) { <p class="notice" role="alert">@_message</p> }
        <div class="settings-actions">
            <button class="primary-button" disabled="@_busy" @onclick="ConfirmAsync">@(_preview ? T("SessionStart.StartThis") : T("SessionStart.Confirm"))</button>
            <button class="secondary-button" disabled="@_busy" @onclick="Close">@T("SessionStart.Back")</button>
        </div>
    </section></div>
}

@code {
    private WorkoutSession? _pending;
    private bool _preview;
    private bool _busy;
    private string _gym = "One Air";
    private string _message = "";
    private IDisposable? _backRegistration;
    protected override void OnInitialized()
    {
        if (Services.GetService(typeof(AppNavigationService)) is AppNavigationService navigation)
            _backRegistration = navigation.RegisterBackHandler(HandleBackAsync, 10);
    }
    public void Select(WorkoutSession session, bool confirmOnly = false, bool preferPlanGym = false)
    {
        if (State.Data.ActiveWorkout is not null) return;
        _pending = session;
        var programGym = State.Programs.FirstOrDefault(program => (program.Gym is "One Air" or "Basic-Fit" or "Basic Fit")
            && program.Sessions.Any(candidate => candidate.Id == session.Id))?.Gym;
        var selectedGym = programGym ?? (preferPlanGym ? PlanGym(session) : SessionsProgramGym(session)) ?? State.CurrentGym;
        _gym = selectedGym.Trim() == "Basic Fit" ? "Basic-Fit" : selectedGym;
        _preview = !confirmOnly; _message = "";
        StateHasChanged();
    }
    private string? SessionsProgramGym(WorkoutSession session) => State.Programs
        .Any(program => program.Id == WorkoutStateService.SessionsProgramId && program.Sessions.Any(candidate => candidate.Id == session.Id))
        ? PlanGym(session) : null;
    private static string? PlanGym(WorkoutSession session)
    {
        var gyms = session.Exercises.Concat(session.OptionalExercises)
            .Select(plan => plan.Gym is null ? null : ProgramDraft.NormalizeGym(plan.Gym)).Distinct().ToArray();
        return gyms is [("One Air" or "Basic-Fit") and var gym] ? gym : null;
    }
    private async Task ShareAsync(WorkoutSession resolved, Func<Func<WorkoutSession>, Task<string>> share)
    {
        if (_busy) return;
        _busy = true; _message = "";
        try { _message = await share(() => SessionExport.FromPlan(resolved, _gym, State.AllExercises)); }
        finally { _busy = false; }
    }
    private SessionSharer Sharer => new(Services, State);
    private async Task ConfirmAsync()
    {
        if (_preview) { _preview = false; return; }
        if (_pending is null || _busy) return;
        _busy = true;
        try
        {
            var result = await State.StartAsync(_pending, _gym);
            if (!result.IsSuccess) { _message = WorkoutUi.Error(result.Error); return; }
            var free = _pending.Id == "free";
            _pending = null;
            Navigation.NavigateTo(free ? "/seance?ajouter=1" : "/seance");
        }
        catch { _message = WorkoutUi.Error(null); }
        finally { _busy = false; }
    }
    private void Close() => _pending = null;
    private async Task<bool> HandleBackAsync()
    {
        if (_pending is null) return false;
        await InvokeAsync(() => { if (!_busy) Close(); StateHasChanged(); });
        return true;
    }
    public void Dispose() => _backRegistration?.Dispose();
}
