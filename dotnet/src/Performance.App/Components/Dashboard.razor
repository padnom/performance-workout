@using Performance.Application
@using Performance.Domain
@inject WorkoutStateService State
@inject TimeProvider Clock

<section class="dashboard" aria-label="Accueil entraînement">
    <div class="dashboard-metrics">
        <section class="dashboard-metric weekly-metric" aria-label="Séances des 7 derniers jours">
            <p class="eyebrow">CETTE SEMAINE</p>
            <strong>@_weekCount <small>@(_weekCount == 1 ? "séance" : "séances")</small></strong>
            <span>@(_weekCount >= 4 ? "Objectif atteint ✓" : $"{4 - _weekCount} avant l’objectif")</span>
        </section>
        <section class="dashboard-metric sets-metric" aria-label="Séries des 7 derniers jours">
            <p class="eyebrow">SÉRIES · 7 J</p>
            <strong>@_weekSets <small>séries</small></strong>
            <span>@(_weekSets == 0 ? "Commence ta 1re séance" : "Séries avec répétitions enregistrées")</span>
        </section>
    </div>
    <button class="free-workout-card" disabled="@Disabled" @onclick="() => Free.InvokeAsync()">
        <span class="free-icon" aria-hidden="true">＋</span>
        <span><strong>Séance libre</strong><small>Recherche et ajoute tes exercices à la volée</small></span>
        <b aria-hidden="true">→</b>
    </button>
    <a class="action-link choose-session" href="/programmes">Choisir une séance →</a>
</section>

@code {
    [Parameter] public EventCallback Free { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private int _weekCount;
    private int _weekSets;
    protected override void OnParametersSet()
    {
        var now = Clock.GetUtcNow();
        _weekCount = State.Data.History.Count(log => IsRecent(log, now, 7));
        _weekSets = State.Data.History.Where(log => IsRecent(log, now, 7)).Sum(log => WorkoutUi.CompletedSets(log).Count());
    }
    private static bool IsRecent(TrainingSessionLog log, DateTimeOffset now, int days) => log.Date <= now && log.Date > now.AddDays(-days);
}
