@using Performance.Application
@using Performance.Domain
@inject WorkoutStateService State
@inject TimeProvider Clock

<section class="dashboard" aria-label="@T("Dashboard.Aria")">
    <div class="dashboard-metrics">
        <section class="dashboard-metric weekly-metric" aria-label="@T("Dashboard.WeekAria")">
            <p class="eyebrow">@T("Dashboard.ThisWeek")</p>
            <strong>@_weekCount <small>@(_weekCount == 1 ? T("Dashboard.WorkoutOne") : T("Dashboard.WorkoutMany"))</small></strong>
            <span>@(_weekCount >= 4 ? T("Dashboard.GoalReached") : T("Dashboard.ToGoal", 4 - _weekCount))</span>
        </section>
        <section class="dashboard-metric sets-metric" aria-label="@T("Dashboard.SetsAria")">
            <p class="eyebrow">@T("Dashboard.SetsEyebrow")</p>
            <strong>@_weekSets <small>@T("Dashboard.Sets")</small></strong>
            <span>@(_weekSets == 0 ? T("Dashboard.StartFirst") : T("Dashboard.SetsRecorded"))</span>
        </section>
    </div>
    <button class="free-workout-card" disabled="@Disabled" @onclick="() => Free.InvokeAsync()">
        <span class="free-icon" aria-hidden="true">＋</span>
        <span><strong>@T("Dashboard.FreeWorkout")</strong><small>@T("Dashboard.FreeWorkoutHint")</small></span>
        <b aria-hidden="true">→</b>
    </button>
    <a class="action-link choose-session" href="/programmes">@T("Dashboard.ChooseWorkout")</a>
</section>

@code {
    [Parameter] public EventCallback Free { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private int _weekCount;
    private int _weekSets;
    protected override void OnParametersSet()
    {
        var now = Clock.GetUtcNow();
        _weekCount = State.Data.History.Count(log => IsRecent(log, now, 7));
        _weekSets = State.Data.History.Where(log => IsRecent(log, now, 7)).Sum(log => WorkoutUi.CompletedSets(log).Count());
    }
    private static bool IsRecent(TrainingSessionLog log, DateTimeOffset now, int days) => log.Date <= now && log.Date > now.AddDays(-days);
}
