@using Performance.Application
@using Performance.Domain
@inject WorkoutStateService State

<button class="secondary-button program-favorite" data-favorite-program="@ProgramId" aria-pressed="@(Favorite ? "true" : "false")" aria-label="@(Favorite ? T("Favorite.Remove", ProgramName) : T("Favorite.Add", ProgramName))" aria-busy="@(_busy ? "true" : "false")" disabled="@(_busy || Disabled)" @onclick="ToggleAsync"><span aria-hidden="true">@(Favorite ? "★" : "☆")</span></button>
@if (_message.Length > 0) { <p class="notice favorite-error" role="alert">@_message</p> }

@code {
    [Parameter, EditorRequired] public string ProgramId { get; set; } = "";
    [Parameter, EditorRequired] public string ProgramName { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public PerformanceData? Snapshot { get; set; }
    private bool _busy;
    private string _message = "";
    private bool Favorite => State.IsProgramFavorite(ProgramId);
    private async Task ToggleAsync()
    {
        if (_busy || Disabled) return;
        _busy = true;
        try
        {
            var result = await State.ToggleProgramFavoriteAsync(ProgramId);
            _message = result.IsSuccess ? "" : WorkoutUi.Error(result.Error);
            if (result.IsSuccess) await Changed.InvokeAsync();
        }
        catch { _message = WorkoutUi.Error(null); }
        finally { _busy = false; }
    }
}
