@using Performance.Application
@using Performance.Domain
@using Performance.App.Services
@implements IDisposable
@inject WorkoutStateService State
@inject IServiceProvider Services

@if (_message.Length > 0 && !_exportOpen && _preview is null && _sessionPreview is null) { <p class="notice program-sharing-message" role="status">@_message</p> }
@if (_exportOpen)
{
    <div class="modal-backdrop sheet-backdrop" @onclick="CloseExport"><section class="panel sheet program-sharing" role="dialog" aria-modal="true" aria-labelledby="program-sharing-title" @onclick:stopPropagation="true">
        <h2 id="program-sharing-title">@T("Sharing.ExportTitle")</h2>
        <p class="muted">@T("Sharing.ExportIntro")</p>
        <fieldset disabled="@_busy"><legend>@T("Sharing.ProgramsLegend")</legend>
            @foreach (var program in State.Programs.Where(program => program.Id != "react-week-plan"))
            {
                <label class="program-share-choice"><input type="checkbox" data-share-program="@program.Id" checked="@_selected.Contains(program.Id)" @onchange="args => Select(program.Id, args.Value is true)" /> @ProgramLibrary.DisplayName(program) @(!string.IsNullOrEmpty(program.Gym) ? $"· {WorkoutUi.GymName(program.Gym)}" : "")</label>
            }
        </fieldset>
        @if (_message.Length > 0) { <p class="notice" role="status">@_message</p> }
        <div class="settings-actions"><button class="primary-button export-programs" disabled="@(_busy || _selected.Count == 0)" @onclick="ShareAsync">@T("Sharing.ExportTitle")</button><button class="secondary-button close-program-sharing" disabled="@_busy" @onclick="CloseExport">Fermer</button></div>
    </section></div>
}
@if (_preview is { } package)
{
    <div class="modal-backdrop"><section class="panel confirm-dialog program-import-preview" role="dialog" aria-modal="true" aria-labelledby="program-import-title">
        <h2 id="program-import-title">@T("Sharing.ImportProgramsTitle")</h2><p>@T("Sharing.ImportCounts", package.Programs.Count, package.Programs.Sum(program => program.Sessions.Count), package.Exercises.Count)</p>
        <ul>@foreach (var program in package.Programs) { <li>@program.Name @WorkoutUi.GymName(program.Gym)</li> }</ul>
        <p class="muted">@T("Sharing.CopiesNote")</p>
        @if (_message.Length > 0) { <p class="notice" role="alert">@_message</p> }
        <div class="settings-actions"><button class="primary-button confirm-program-import" disabled="@_busy" @onclick="ConfirmAsync">@T("Sharing.AddCopies")</button><button class="secondary-button cancel-program-import" disabled="@_busy" @onclick="() => _preview = null">@T("Sharing.Cancel")</button></div>
    </section></div>
}

@if (_sessionPreview is { } sessionPackage)
{
    <div class="modal-backdrop"><section class="panel confirm-dialog session-import-preview" role="dialog" aria-modal="true" aria-labelledby="session-import-title">
        <h2 id="session-import-title">@T("Sharing.ImportSessionTitle")</h2><p>@sessionPackage.Session.Name</p>
        <p>@T("Sharing.ExerciseCount", sessionPackage.Session.Exercises.Count)</p>
        <ul>@foreach (var plan in sessionPackage.Session.Exercises) { <li>@ExerciseName(plan.ExerciseId, sessionPackage)</li> }</ul>
        @if (sessionPackage.Session.OptionalExercises.Count > 0) { <p class="muted">@T("Sharing.OptionalCount", sessionPackage.Session.OptionalExercises.Count)</p> }
        <p class="muted">@T("Sharing.AddedInMyWorkouts")</p>
        @if (_message.Length > 0) { <p class="notice" role="alert">@_message</p> }
        <div class="settings-actions"><button class="primary-button confirm-session-import" disabled="@_busy" @onclick="ConfirmSessionAsync">@T("Sharing.AddToMyWorkouts")</button><button class="secondary-button cancel-session-import" disabled="@_busy" @onclick="() => _sessionPreview = null">@T("Sharing.Cancel")</button></div>
    </section></div>
}

@code {
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public PerformanceData? Snapshot { get; set; }
    private readonly HashSet<string> _selected = [];
    private bool _exportOpen, _busy;
    private string _message = "";
    private ProgramPackage? _preview;
    private SessionPackage? _sessionPreview;
    private IncomingShareService? _incoming;
    private IDisposable? _backRegistration;
    protected override void OnInitialized()
    {
        if (Services.GetService(typeof(AppNavigationService)) is AppNavigationService navigation) _backRegistration = navigation.RegisterBackHandler(BackAsync, 10);
        _incoming = Services.GetService(typeof(IncomingShareService)) as IncomingShareService;
        if (_incoming is null) return;
        _incoming.Received += OnReceived;
        Open(_incoming.Consume());
    }
    private void OnReceived() => _ = InvokeAsync(() => { Open(_incoming?.Consume()); StateHasChanged(); });
    private void Open(IncomingShare? share)
    {
        if (share is null) return;
        _message = "";
        if (share.Error is not null) { _message = share.Error; return; }
        try
        {
            var shared = Get<ReadSharedFileUseCase>().Execute(share.Json ?? "");
            if (shared is SharedSession session) _sessionPreview = session.Package;
            if (shared is SharedPrograms programs) _preview = programs.Package;
        }
        catch (FormatException exception) { _message = exception.Message; }
        catch { _message = T("Sharing.ReadFailed"); }
    }
    private string ExerciseName(string id, SessionPackage package) =>
        (State.AllExercises.FirstOrDefault(item => item.Id == id) ?? package.Exercises.FirstOrDefault(item => item.Id == id))?.Name ?? id;
    // Called from the ⋯ menu, outside this component's own handlers, hence the explicit StateHasChanged.
    public async Task PickSessionAsync()
    {
        if (_busy) return;
        _busy = true; _message = "";
        try
        {
            var json = await Get<IProgramFiles>().PickSessionAsync();
            if (json is not null) _sessionPreview = Get<ImportWorkoutSessionUseCase>().Execute(json);
        }
        catch (FormatException exception) { _message = exception.Message; }
        catch { _message = T("Sharing.ReadSessionFailed"); }
        finally { _busy = false; StateHasChanged(); }
    }
    private async Task ConfirmSessionAsync()
    {
        if (_busy || _sessionPreview is null) return;
        _busy = true;
        try
        {
            var result = await State.ImportSessionAsync(_sessionPreview);
            if (!result.IsSuccess) { _message = WorkoutUi.Error(result.Error); return; }
            _sessionPreview = null; _message = T("Sharing.SessionAdded");
            await Changed.InvokeAsync();
        }
        catch { _message = WorkoutUi.Error(null); }
        finally { _busy = false; }
    }
    public void OpenExport() { _message = ""; _exportOpen = true; StateHasChanged(); }
    private void CloseExport() { if (!_busy) _exportOpen = false; }
    private void Select(string id, bool value) { if (value) _selected.Add(id); else _selected.Remove(id); }
    private T Get<T>() where T : class => Services.GetService(typeof(T)) as T ?? throw new InvalidOperationException();
    private async Task ShareAsync()
    {
        if (_busy) return;
        _busy = true; _message = "";
        try
        {
            var programs = State.Programs.Where(program => _selected.Contains(program.Id)).ToList();
            var json = Get<ExportWorkoutProgramsUseCase>().Execute(programs, State.AllExercises);
            await Get<IProgramFiles>().ShareProgramsAsync(json);
            _message = T("Sharing.ExportReady");
        }
        catch (FormatException exception) { _message = exception.Message; }
        catch { _message = T("Sharing.ShareFailed"); }
        finally { _busy = false; }
    }
    public async Task PickAsync()
    {
        if (_busy) return;
        _busy = true; _message = "";
        try
        {
            var json = await Get<IProgramFiles>().PickProgramsAsync();
            if (json is not null) _preview = Get<ImportWorkoutProgramsUseCase>().Execute(json);
        }
        catch (FormatException exception) { _message = exception.Message; }
        catch { _message = T("Sharing.ReadProgramsFailed"); }
        finally { _busy = false; StateHasChanged(); }
    }
    private async Task ConfirmAsync()
    {
        if (_busy || _preview is null) return;
        _busy = true;
        try
        {
            var result = await State.ImportProgramsAsync(_preview);
            if (!result.IsSuccess) { _message = WorkoutUi.Error(result.Error); return; }
            _preview = null; _message = T("Sharing.CopiesAdded");
            await Changed.InvokeAsync();
        }
        catch { _message = WorkoutUi.Error(null); }
        finally { _busy = false; }
    }
    private async Task<bool> BackAsync()
    {
        if (_preview is null && _sessionPreview is null && !_exportOpen) return false;
        await InvokeAsync(() => { if (!_busy) { _preview = null; _sessionPreview = null; _exportOpen = false; } StateHasChanged(); }); return true;
    }
    public void Dispose()
    {
        _backRegistration?.Dispose();
        if (_incoming is not null) _incoming.Received -= OnReceived;
    }
}
