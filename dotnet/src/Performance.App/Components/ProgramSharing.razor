@using Performance.Application
@using Performance.Domain
@using Performance.App.Services
@implements IDisposable
@inject WorkoutStateService State
@inject IServiceProvider Services

<section class="panel program-sharing" aria-label="Partager des programmes">
    <p class="eyebrow">PARTAGE</p><h2>Partager des programmes</h2>
    <p class="muted">Fichier JSON avec les exercices et les consignes. Aucune charge personnelle ni historique.</p>
    <fieldset disabled="@_busy"><legend>Choisir le contenu</legend>
        <label class="program-share-choice"><input type="checkbox" checked="@_week" @onchange="args => _week = args.Value is true" disabled="@(State.WeekSessions.Count == 0)" /> Ma semaine (@State.WeekSessions.Count séances)</label>
        @foreach (var program in State.Programs.Where(program => program.Id != "react-week-plan"))
        {
            <label class="program-share-choice"><input type="checkbox" data-share-program="@program.Id" checked="@_selected.Contains(program.Id)" @onchange="args => Select(program.Id, args.Value is true)" /> @program.Name @(!string.IsNullOrEmpty(program.Gym) ? $"· {program.Gym}" : "")</label>
        }
    </fieldset>
    <div class="settings-actions"><button class="secondary-button export-programs" disabled="@(_busy || (!_week && _selected.Count == 0))" @onclick="ShareAsync">Exporter / partager</button><button class="secondary-button import-programs" disabled="@_busy" @onclick="PickAsync">Importer des programmes</button><button class="secondary-button import-session" disabled="@_busy" @onclick="PickSessionAsync">Importer une séance</button></div>
    @if (_message.Length > 0) { <p class="notice" role="status">@_message</p> }
</section>
@if (_preview is { } package)
{
    <div class="modal-backdrop"><section class="panel confirm-dialog program-import-preview" role="dialog" aria-modal="true" aria-labelledby="program-import-title">
        <h2 id="program-import-title">Ajouter ces programmes ?</h2><p>@package.Programs.Count programme(s) · @package.Programs.Sum(program => program.Sessions.Count) séance(s) · @package.Exercises.Count exercice(s)</p>
        <ul>@foreach (var program in package.Programs) { <li>@program.Name @program.Gym</li> }</ul>
        <p class="muted">Ajout de copies. Ta semaine, ta séance en cours et ton historique restent conservés.</p>
        @if (_message.Length > 0) { <p class="notice" role="alert">@_message</p> }
        <div class="settings-actions"><button class="primary-button confirm-program-import" disabled="@_busy" @onclick="ConfirmAsync">Ajouter les copies</button><button class="secondary-button cancel-program-import" disabled="@_busy" @onclick="() => _preview = null">Annuler</button></div>
    </section></div>
}

@if (_sessionPreview is { } sessionPackage)
{
    <div class="modal-backdrop"><section class="panel confirm-dialog session-import-preview" role="dialog" aria-modal="true" aria-labelledby="session-import-title">
        <h2 id="session-import-title">Ajouter cette séance ?</h2><p>@sessionPackage.Session.Name</p>
        <p>@sessionPackage.Session.Exercises.Count exercice(s)</p>
        <ul>@foreach (var plan in sessionPackage.Session.Exercises) { <li>@ExerciseName(plan.ExerciseId, sessionPackage)</li> }</ul>
        @if (sessionPackage.Session.OptionalExercises.Count > 0) { <p class="muted">+ @sessionPackage.Session.OptionalExercises.Count exercice(s) optionnel(s)</p> }
        <p class="muted">Ajoutée dans Mes séances. Ta semaine, ta séance en cours et ton historique restent conservés.</p>
        @if (_message.Length > 0) { <p class="notice" role="alert">@_message</p> }
        <div class="settings-actions"><button class="primary-button confirm-session-import" disabled="@_busy" @onclick="ConfirmSessionAsync">Ajouter à Mes séances</button><button class="secondary-button cancel-session-import" disabled="@_busy" @onclick="() => _sessionPreview = null">Annuler</button></div>
    </section></div>
}

@code {
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public PerformanceData? Snapshot { get; set; }
    private readonly HashSet<string> _selected = [];
    private bool _week, _busy;
    private string _message = "";
    private ProgramPackage? _preview;
    private SessionPackage? _sessionPreview;
    private IncomingShareService? _incoming;
    private IDisposable? _backRegistration;
    protected override void OnInitialized()
    {
        if (Services.GetService(typeof(AppNavigationService)) is AppNavigationService navigation) _backRegistration = navigation.RegisterBackHandler(BackAsync, 10);
        _incoming = Services.GetService(typeof(IncomingShareService)) as IncomingShareService;
        if (_incoming is null) return;
        _incoming.Received += OnReceived;
        Open(_incoming.Consume());
    }
    private void OnReceived() => _ = InvokeAsync(() => { Open(_incoming?.Consume()); StateHasChanged(); });
    private void Open(IncomingShare? share)
    {
        if (share is null) return;
        _message = "";
        if (share.Error is not null) { _message = share.Error; return; }
        try
        {
            var shared = Get<ReadSharedFileUseCase>().Execute(share.Json ?? "");
            if (shared is SharedSession session) _sessionPreview = session.Package;
            if (shared is SharedPrograms programs) _preview = programs.Package;
        }
        catch (FormatException exception) { _message = exception.Message; }
        catch { _message = "Impossible de lire ce fichier. Réessaie."; }
    }
    private string ExerciseName(string id, SessionPackage package) =>
        (State.AllExercises.FirstOrDefault(item => item.Id == id) ?? package.Exercises.FirstOrDefault(item => item.Id == id))?.Name ?? id;
    private async Task PickSessionAsync()
    {
        if (_busy) return;
        _busy = true; _message = "";
        try
        {
            var json = await Get<IProgramFiles>().PickSessionAsync();
            if (json is not null) _sessionPreview = Get<ImportWorkoutSessionUseCase>().Execute(json);
        }
        catch (FormatException exception) { _message = exception.Message; }
        catch { _message = "Impossible de lire ce fichier de séance. Réessaie."; }
        finally { _busy = false; }
    }
    private async Task ConfirmSessionAsync()
    {
        if (_busy || _sessionPreview is null) return;
        _busy = true;
        try
        {
            var result = await State.ImportSessionAsync(_sessionPreview);
            if (!result.IsSuccess) { _message = WorkoutUi.Error(result.Error); return; }
            _sessionPreview = null; _message = "La séance a été ajoutée à Mes séances.";
            await Changed.InvokeAsync();
        }
        catch { _message = WorkoutUi.Error(null); }
        finally { _busy = false; }
    }
    private void Select(string id, bool value) { if (value) _selected.Add(id); else _selected.Remove(id); }
    private T Get<T>() where T : class => Services.GetService(typeof(T)) as T ?? throw new InvalidOperationException();
    private async Task ShareAsync()
    {
        if (_busy) return;
        _busy = true; _message = "";
        try
        {
            var programs = State.Programs.Where(program => _selected.Contains(program.Id)).ToList();
            if (_week && State.WeekSessions.Count > 0) programs.Insert(0, new WorkoutProgram { Id = "week-share", Name = "Ma semaine", Sessions = State.WeekSessions });
            var json = Get<ExportWorkoutProgramsUseCase>().Execute(programs, State.AllExercises);
            await Get<IProgramFiles>().ShareProgramsAsync(json);
            _message = "Fichier de programmes prêt à partager.";
        }
        catch (FormatException exception) { _message = exception.Message; }
        catch { _message = "Impossible de partager le fichier de programmes. Réessaie."; }
        finally { _busy = false; }
    }
    private async Task PickAsync()
    {
        if (_busy) return;
        _busy = true; _message = "";
        try
        {
            var json = await Get<IProgramFiles>().PickProgramsAsync();
            if (json is not null) _preview = Get<ImportWorkoutProgramsUseCase>().Execute(json);
        }
        catch (FormatException exception) { _message = exception.Message; }
        catch { _message = "Impossible de lire ce fichier de programmes. Réessaie."; }
        finally { _busy = false; }
    }
    private async Task ConfirmAsync()
    {
        if (_busy || _preview is null) return;
        _busy = true;
        try
        {
            var result = await State.ImportProgramsAsync(_preview);
            if (!result.IsSuccess) { _message = WorkoutUi.Error(result.Error); return; }
            _preview = null; _message = "Les copies ont été ajoutées à Autres programmes · Personnalisés.";
            await Changed.InvokeAsync();
        }
        catch { _message = WorkoutUi.Error(null); }
        finally { _busy = false; }
    }
    private async Task<bool> BackAsync()
    {
        if (_preview is null && _sessionPreview is null) return false;
        await InvokeAsync(() => { if (!_busy) { _preview = null; _sessionPreview = null; } StateHasChanged(); }); return true;
    }
    public void Dispose()
    {
        _backRegistration?.Dispose();
        if (_incoming is not null) _incoming.Received -= OnReceived;
    }
}
