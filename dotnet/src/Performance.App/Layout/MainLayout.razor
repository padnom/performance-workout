@inherits LayoutComponentBase
@implements IDisposable
@using Performance.App.Services
@using Performance.Application
@inject IServiceProvider Services
@inject NavigationManager Navigation

<div class="app-shell" data-gym="@GymTheme.For(Gym)">
    <header class="topbar"><a class="brand" href="/" aria-label="Performance, accueil"><img class="brand-mark" src="logo.svg" alt="" width="32" height="32" /><span>PERFORMANCE</span></a><span class="offline-pill" title="Salle actuelle">@if (GymTheme.Logo(Gym) is { } logo) { <img class="gym-logo" src="@logo" alt="" width="20" height="20" /> } else { <span></span> } @GymLabel</span></header>
    <main class="content @(IsWorkout ? "workout-content" : "")" @key="Navigation.Uri">
        @if (!IsWorkout && _updates is { ShowBanner: true }) { <UpdateBanner Updates="_updates" /> }
        @Body
    </main>
    @if (_plusOpen)
    {
        <div class="plus-menu-backdrop" @onclick="ClosePlus"></div>
        <section class="panel plus-menu" aria-label="Autres écrans"><a href="/exercices" @onclick="ClosePlus">◉ Exercices</a><a href="/reglages" @onclick="ClosePlus">⚙ Réglages</a></section>
    }
    <nav class="bottom-nav" aria-label="Navigation principale">
        <NavLink href="/" Match="NavLinkMatch.All"><span class="nav-icon">⌂</span><span>Accueil</span></NavLink>
        <NavLink href="/programmes" Match="NavLinkMatch.All"><span class="nav-icon">▦</span><span>Programmes</span></NavLink>
        <NavLink href="/progres"><span class="nav-icon">↗</span><span>Progrès</span></NavLink>
        <NavLink href="/historique"><span class="nav-icon">◷</span><span>Historique</span></NavLink>
        <button class="@(_plusOpen ? "active" : "")" aria-expanded="@(_plusOpen ? "true" : "false")" aria-label="Plus" @onclick="() => _plusOpen = !_plusOpen"><span class="nav-icon">•••</span><span>Plus</span></button>
    </nav>
</div>

@code {
    private bool _plusOpen;
    private bool IsWorkout => new Uri(Navigation.Uri).AbsolutePath == "/seance";
    private AppNavigationService? _navigation;
    private IDisposable? _backRegistration;
    private IncomingShareService? _incomingShare;
    private WorkoutStateService? _state;
    private AppUpdateService? _updates;
    private string? Gym => _state is null ? null : GymTheme.CurrentGym(_state);
    private string GymLabel => Gym switch { null => "LOCAL", "Toutes" => "TOUTES SALLES", var gym => WorkoutUi.GymName(gym).ToUpperInvariant() };
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += LocationChanged;
        _state = Services.GetService(typeof(WorkoutStateService)) as WorkoutStateService;
        if (_state is not null) _state.DataChanged += Refresh;
        _updates = Services.GetService(typeof(AppUpdateService)) as AppUpdateService;
        if (_updates is not null) _updates.Changed += RefreshUpdates;
        _incomingShare = Services.GetService(typeof(IncomingShareService)) as IncomingShareService;
        if (_incomingShare is not null)
        {
            _incomingShare.Received += OpenPrograms;
            if (_incomingShare.HasPending) OpenPrograms();
        }
        _navigation = Services.GetService(typeof(AppNavigationService)) as AppNavigationService;
        if (_navigation is null) return;
        _backRegistration = _navigation.RegisterBackHandler(HandleBackAsync, 20);
        _navigation.WorkoutRequested += OpenWorkout;
        if (_navigation.ConsumeWorkoutRequest()) OpenWorkout();
    }
    private void Refresh(PerformanceData data) => _ = InvokeAsync(StateHasChanged);
    private void RefreshUpdates() => _ = InvokeAsync(StateHasChanged);
    private void OpenWorkout() => _ = InvokeAsync(() => Navigation.NavigateTo("/seance"));
    private void OpenPrograms() => _ = InvokeAsync(() =>
    {
        if (!IsWorkout) Navigation.NavigateTo("/programmes");
    });
    private void ClosePlus() => _plusOpen = false;
    private void LocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(() => { ClosePlus(); StateHasChanged(); });
    private async Task<bool> HandleBackAsync()
    {
        if (!_plusOpen) return false;
        await InvokeAsync(() => { ClosePlus(); StateHasChanged(); });
        return true;
    }
    public void Dispose()
    {
        Navigation.LocationChanged -= LocationChanged;
        if (_state is not null) _state.DataChanged -= Refresh;
        if (_updates is not null) _updates.Changed -= RefreshUpdates;
        if (_incomingShare is not null) _incomingShare.Received -= OpenPrograms;
        if (_navigation is not null) _navigation.WorkoutRequested -= OpenWorkout;
        _backRegistration?.Dispose();
    }
}
