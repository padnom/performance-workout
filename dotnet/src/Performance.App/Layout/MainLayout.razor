@inherits LayoutComponentBase
@implements IDisposable
@using Performance.App.Services
@using Performance.Application
@inject IServiceProvider Services
@inject NavigationManager Navigation

<div class="app-shell" data-gym="@GymTheme.For(Gym)">
    <header class="topbar"><a class="brand" href="/" aria-label="@T("Layout.HomeAria")"><img class="brand-mark" src="logo.svg" alt="" width="32" height="32" /><span>PERFORMANCE</span></a><button class="offline-pill gym-switch" title="@T("Layout.SwitchGym")" aria-label="@T("Layout.CurrentGymAria", GymLabel)" aria-haspopup="menu" aria-expanded="@(_gymOpen ? "true" : "false")" disabled="@(_state is null || _gymBusy)" @onclick="ToggleGym">@if (GymTheme.Logo(Gym) is { } logo) { <img class="gym-logo" src="@logo" alt="" width="20" height="20" /> } else { <span></span> } @GymLabel <b aria-hidden="true">▾</b></button></header>
    @if (_gymOpen)
    {
        <div class="plus-menu-backdrop" @onclick="CloseGym"></div>
        <section class="panel gym-menu" role="menu" aria-label="@T("Layout.ChooseGym")">
            <p class="eyebrow">@(_state?.Data.ActiveWorkout is null ? T("Layout.GymEyebrow") : T("Layout.GymEyebrowWorkout"))</p>
            @foreach (var gym in WorkoutUi.Gyms)
            {
                <button role="menuitemradio" aria-checked="@(gym == Gym ? "true" : "false")" class="@(gym == Gym ? "active" : "")" data-gym="@gym" disabled="@_gymBusy" @onclick="() => SelectGymAsync(gym)">@if (GymTheme.Logo(gym) is { } icon) { <img src="@icon" alt="" width="20" height="20" /> } else { <span class="gym-dot"></span> }@WorkoutUi.GymName(gym)@if (gym == Gym) { <b aria-hidden="true">✓</b> }</button>
            }
            @if (_gymError.Length > 0) { <p class="notice" role="alert">@_gymError</p> }
        </section>
    }
    <main class="content @(IsWorkout ? "workout-content" : "")" @key="(Navigation.Uri, DisplayLanguage.Revision)">
        @if (!IsWorkout && _updates is { ShowBanner: true }) { <UpdateBanner Updates="_updates" /> }
        @Body
    </main>
    @if (!IsWorkout && _releaseNotes.Count > 0) { <ReleaseNotesDialog Notes="_releaseNotes" Busy="_closingNotes" Closed="CloseReleaseNotesAsync" /> }
    @if (_plusOpen)
    {
        <div class="plus-menu-backdrop" @onclick="ClosePlus"></div>
        <section class="panel plus-menu" aria-label="@T("Layout.MoreScreens")"><a href="/exercices" @onclick="ClosePlus">◉ @T("Layout.Exercises")</a><a href="/reglages" @onclick="ClosePlus">⚙ @T("Layout.Settings")</a></section>
    }
    <nav class="bottom-nav" aria-label="@T("Layout.MainNavigation")">
        <NavLink href="/" Match="NavLinkMatch.All"><span class="nav-icon">⌂</span><span>@T("Layout.Home")</span></NavLink>
        <NavLink href="/programmes" Match="NavLinkMatch.All"><span class="nav-icon">▦</span><span>@T("Layout.Programs")</span></NavLink>
        <NavLink href="/progres"><span class="nav-icon">↗</span><span>@T("Layout.Progress")</span></NavLink>
        <NavLink href="/historique"><span class="nav-icon">◷</span><span>@T("Layout.History")</span></NavLink>
        <button class="@(_plusOpen ? "active" : "")" aria-expanded="@(_plusOpen ? "true" : "false")" aria-label="@T("Layout.More")" @onclick="() => { _gymOpen = false; _plusOpen = !_plusOpen; }"><span class="nav-icon">•••</span><span>@T("Layout.More")</span></button>
    </nav>
</div>

@code {
    private bool _plusOpen;
    private bool _gymOpen;
    private bool _gymBusy;
    private string _gymError = "";
    private bool IsWorkout => new Uri(Navigation.Uri).AbsolutePath == "/seance";
    private AppNavigationService? _navigation;
    private IDisposable? _backRegistration;
    private IncomingShareService? _incomingShare;
    private WorkoutStateService? _state;
    private AppUpdateService? _updates;
    private IApkInstaller? _installer;
    private IReadOnlyList<ReleaseNote> _releaseNotes = [];
    private bool _releaseNotesChecked;
    private bool _closingNotes;
    private string? Gym => _state is null ? null : GymTheme.CurrentGym(_state);
    private string GymLabel => Gym switch { null => T("Layout.GymLocal"), "Toutes" => T("Layout.GymAll"), var gym => WorkoutUi.GymName(gym).ToUpperInvariant() };
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += LocationChanged;
        DisplayLanguage.Changed += LanguageChanged;
        _state = Services.GetService(typeof(WorkoutStateService)) as WorkoutStateService;
        if (_state is not null) _state.DataChanged += Refresh;
        _installer = Services.GetService(typeof(IApkInstaller)) as IApkInstaller;
        CheckReleaseNotes();
        _updates = Services.GetService(typeof(AppUpdateService)) as AppUpdateService;
        if (_updates is not null) _updates.Changed += RefreshUpdates;
        _incomingShare = Services.GetService(typeof(IncomingShareService)) as IncomingShareService;
        if (_incomingShare is not null)
        {
            _incomingShare.Received += OpenPrograms;
            if (_incomingShare.HasPending) OpenPrograms();
        }
        _navigation = Services.GetService(typeof(AppNavigationService)) as AppNavigationService;
        if (_navigation is null) return;
        _backRegistration = _navigation.RegisterBackHandler(HandleBackAsync, 20);
        _navigation.WorkoutRequested += OpenWorkout;
        if (_navigation.ConsumeWorkoutRequest()) OpenWorkout();
    }
    private void Refresh(PerformanceData data) => _ = InvokeAsync(() => { CheckReleaseNotes(); StateHasChanged(); });
    private void CheckReleaseNotes()
    {
        if (_releaseNotesChecked || _state is not { IsInitialized: true } || _installer is null) return;
        _releaseNotesChecked = true;
        _releaseNotes = ReleaseNotes.Unseen(_state.ReleaseNotesSeenVersion, _installer.InstalledVersion);
    }
    private async Task CloseReleaseNotesAsync()
    {
        if (_closingNotes || _state is null || _installer is null) return;
        _closingNotes = true;
        try { await _state.MarkReleaseNotesSeenAsync(_installer.InstalledVersion); }
        finally { _closingNotes = false; _releaseNotes = []; }
    }
    private void LanguageChanged() => _ = InvokeAsync(StateHasChanged);
    private void RefreshUpdates() => _ = InvokeAsync(StateHasChanged);
    private void OpenWorkout() => _ = InvokeAsync(() => Navigation.NavigateTo("/seance"));
    private void OpenPrograms() => _ = InvokeAsync(() =>
    {
        if (!IsWorkout) Navigation.NavigateTo("/programmes");
    });
    private void ClosePlus() => _plusOpen = false;
    private void ToggleGym() { _plusOpen = false; _gymError = ""; _gymOpen = !_gymOpen; }
    private void CloseGym() => _gymOpen = false;
    private async Task SelectGymAsync(string gym)
    {
        if (_state is null || _gymBusy) return;
        if (gym == Gym) { CloseGym(); return; }
        _gymBusy = true; _gymError = "";
        try
        {
            var result = _state.Data.ActiveWorkout is null ? await _state.SetGymAsync(gym) : await _state.SetActiveWorkoutGymAsync(gym);
            if (result.IsSuccess) CloseGym(); else _gymError = WorkoutUi.Error(result.Error);
        }
        catch { _gymError = WorkoutUi.Error(null); }
        finally { _gymBusy = false; }
    }
    private void LocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(() => { ClosePlus(); CloseGym(); StateHasChanged(); });
    private async Task<bool> HandleBackAsync()
    {
        if (!_plusOpen && _releaseNotes.Count > 0 && !IsWorkout)
        {
            await InvokeAsync(CloseReleaseNotesAsync);
            return true;
        }
        if (_gymOpen)
        {
            await InvokeAsync(() => { CloseGym(); StateHasChanged(); });
            return true;
        }
        if (!_plusOpen) return false;
        await InvokeAsync(() => { ClosePlus(); StateHasChanged(); });
        return true;
    }
    public void Dispose()
    {
        Navigation.LocationChanged -= LocationChanged;
        DisplayLanguage.Changed -= LanguageChanged;
        if (_state is not null) _state.DataChanged -= Refresh;
        if (_updates is not null) _updates.Changed -= RefreshUpdates;
        if (_incomingShare is not null) _incomingShare.Received -= OpenPrograms;
        if (_navigation is not null) _navigation.WorkoutRequested -= OpenWorkout;
        _backRegistration?.Dispose();
    }
}
