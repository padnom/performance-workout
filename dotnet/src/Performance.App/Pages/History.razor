@page "/historique"
@using Performance.Application
@using Performance.Domain
@inject WorkoutStateService State

<PageTitle>@T("History.PageTitle")</PageTitle>
<p class="eyebrow">@T("History.Eyebrow")</p>
<h1>@T("History.Title")</h1>
<p class="muted intro">@T("History.Intro")</p>
@if (_loading) { <p class="loading">@T("History.Loading")</p> }
@if (!string.IsNullOrEmpty(_message)) { <p class="notice" role="status">@_message</p> }
@if (!_loading)
{
    <label class="field gym-field">@T("History.FilterByGym")<select @bind="_gym"><option value="">@T("History.AllGyms")</option>@foreach (var gym in WorkoutUi.Gyms) { <option value="@gym">@WorkoutUi.GymName(gym)</option> }</select></label>
    <SessionHistory Gym="@_gym" Replay="ReplaySession" />
    <SessionStart @ref="_starter" />
}

@code {
    private bool _loading = true;
    private string _message = "";
    private string _gym = "";
    private SessionStart? _starter;
    private void ReplaySession(WorkoutSession session) => _starter?.Select(session, preferPlanGym: true);
    protected override async Task OnInitializedAsync()
    {
        try { await State.InitializeAsync(); }
        catch { _message = T("History.LoadFailed"); }
        finally { _loading = false; }
    }
}
