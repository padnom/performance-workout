@page "/"
@using Performance.Application
@using Performance.Domain
@inject WorkoutStateService State

<PageTitle>@T("Home.PageTitle")</PageTitle>
<p class="eyebrow">@T("Home.Eyebrow")</p>
<div class="page-heading"><div><h1>@T("Home.Title")</h1><p class="muted">@T("Home.Tagline")</p></div></div>
@if (_loading) { <p class="loading" role="status">@T("Home.Loading")</p> }
@if (!_loading)
{
    @if (State.Data.ActiveWorkout?.Session is { } active)
    {
        <a class="resume-workout" href="/seance"><span>@T("Home.InProgress")<strong>@(active.Name == "Séance libre" ? T("Home.FreeWorkoutName") : active.Name)</strong></span><b>@T("Home.Resume")</b></a>
    }
    <Dashboard Free="FreeWorkout" Disabled="@(State.Data.ActiveWorkout is not null)" />
    <SessionStart @ref="_starter" />
}
@if (_message.Length > 0) { <p class="notice" role="status">@_message</p> }

@code {
    private bool _loading = true;
    private string _message = "";
    private SessionStart? _starter;
    protected override async Task OnInitializedAsync()
    {
        try { await State.InitializeAsync(); }
        catch { _message = T("Home.LoadFailed"); }
        finally { _loading = false; }
    }
    private void FreeWorkout() => _starter?.Select(new WorkoutSession { Id = "free", Name = "Séance libre", Focus = T("Home.FreeWorkoutFocus") }, confirmOnly: true);
}
