@page "/reglages"
@using Performance.Application
@using Performance.App.Services
@inject WorkoutStateService State
@inject ImportPerformanceBackupUseCase ImportBackup
@inject ExportPerformanceBackupUseCase ExportBackup
@inject IBackupFiles BackupFiles
@inject IServiceProvider Services
@implements IDisposable

<PageTitle>@T("Settings.PageTitle")</PageTitle>
<p class="eyebrow">@T("Settings.Eyebrow")</p>
<h1>@T("Settings.Title")</h1>
<p class="muted intro">@T("Settings.Intro")</p>
@if (_loading) { <p class="loading">@T("Settings.Loading")</p> }
@if (!string.IsNullOrEmpty(_message)) { <p class="notice" role="status">@_message</p> }
@if (!_loading && !_loadFailed)
{
    <section class="panel">
        <h2>@T("Settings.Gym.Title")</h2><p class="muted">@T("Settings.Gym.Hint")</p>
        <label class="field">@T("Settings.Gym.Label")
            <select value="@State.CurrentGym" disabled="@_busy" @onchange="ChangeGymAsync">
                @foreach (var gym in WorkoutUi.Gyms) { <option value="@gym">@WorkoutUi.GymName(gym)</option> }
            </select>
        </label>
    </section>
    @if (_language is not null)
    {
        <section class="panel language-settings">
            <h2>@T("Settings.Language.Title")</h2>
            <label class="field">@T("Settings.Language.Label")
                <select value="@_language.Value" disabled="@_busy" @onchange="ChangeLanguage">
                    @foreach (var choice in DisplayLanguage.Choices) { <option value="@choice">@T("Settings.Language." + choice)</option> }
                </select>
            </label>
        </section>
    }
    <section class="panel notification-settings">
        <h2>@T("Settings.Rest.Title")</h2>
        <label class="field"><span>@T("Settings.Rest.Vibration")</span>
            <input @key="_notificationInputRevision" type="checkbox" checked="@State.RestNotificationsEnabled" disabled="@_busy" @onchange="ChangeNotificationsAsync" />
        </label>
        <p class="muted">@T("Settings.Rest.Hint")</p>
        @if (_notifications is not null) { <p class="muted" role="status">@_notifications.Access.Description</p> }
    </section>
    <section class="panel settings-panel">
        <h2>@T("Settings.Backup.Title")</h2>
        <p class="muted">@T("Settings.Backup.Summary", State.Data.History.Count)</p>
        <div class="data-safety">
            <strong>@T("Settings.Backup.WebTitle")</strong>
            <span>@T("Settings.Backup.WebHint")</span>
        </div>
        <div class="settings-actions">
            <button class="primary-button" disabled="@_busy" @onclick="PickImportAsync">@T("Settings.Backup.Import")</button>
            <button class="secondary-button" disabled="@_busy" @onclick="ShareBackupAsync">@T("Settings.Backup.Export")</button>
        </div>
    </section>
    <section class="panel diagnostic-settings">
        <h2>@T("Settings.App.Title")</h2><p class="muted">@T("Settings.App.Version", _diagnostics?.Version ?? "1.1.0 (2)")</p>
        <p class="muted">@T("Settings.App.DiagnosticsHint")</p>
        <button class="secondary-button" disabled="@(_busy || _diagnostics is null)" @onclick="ShareDiagnosticsAsync">@T("Settings.App.ExportDiagnostics")</button>
    </section>
    @if (_updates is not null)
    {
        <section class="panel update-settings">
            <h2>@T("Settings.Updates.Title")</h2>
            <p class="muted">@T("Settings.Updates.Hint")</p>
            @if (!string.IsNullOrEmpty(_updates.Message)) { <p class="muted" role="status">@_updates.Message</p> }
            <div class="settings-actions">
                @if (_updates.Available is { } release)
                {
                    <button class="primary-button" disabled="@_updates.Busy" @onclick="InstallUpdateAsync">@T("Settings.Updates.Install", release.Version)</button>
                }
                <button class="secondary-button" disabled="@_updates.Busy" @onclick="CheckUpdatesAsync">@T("Settings.Updates.Check")</button>
            </div>
        </section>
    }
}
@if (_loadFailed) { <button class="secondary-button" @onclick="LoadAsync">@T("Settings.RetryLoad")</button> }
@if (_pendingImport is { } pending)
{
    <div class="modal-backdrop">
        <section class="panel confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="import-title">
            <h2 id="import-title">@T("Settings.Import.Title")</h2>
            <p class="muted">@T("Settings.Import.Contents", pending.History.Count, pending.Exercises.Count)</p>
            <p class="notice">@T("Settings.Import.Warning")</p>
            <div class="settings-actions">
                <button class="primary-button" disabled="@_busy" @onclick="ConfirmImportAsync">@T("Settings.Import.Confirm")</button>
                <button class="secondary-button" disabled="@_busy" @onclick="() => _pendingImport = null">@T("Settings.Import.Cancel")</button>
            </div>
        </section>
    </div>
}

@code {
    private bool _loading = true;
    private bool _loadFailed;
    private bool _busy;
    private int _notificationInputRevision;
    private string _message = "";
    private PerformanceData? _pendingImport;
    private RestNotificationCoordinator? _notifications;
    private IAppDiagnostics? _diagnostics;
    private AppUpdateService? _updates;
    private ILanguagePreference? _language;
    private IDisposable? _backRegistration;
    protected override async Task OnInitializedAsync()
    {
        _notifications = Services.GetService(typeof(RestNotificationCoordinator)) as RestNotificationCoordinator;
        _diagnostics = Services.GetService(typeof(IAppDiagnostics)) as IAppDiagnostics;
        _updates = Services.GetService(typeof(AppUpdateService)) as AppUpdateService;
        _language = Services.GetService(typeof(ILanguagePreference)) as ILanguagePreference;
        if (_updates is not null) _updates.Changed += RefreshNotifications;
        if (_notifications is not null) _notifications.Changed += RefreshNotifications;
        _backRegistration = (Services.GetService(typeof(AppNavigationService)) as AppNavigationService)?.RegisterBackHandler(CloseImportAsync, 10);
        await LoadAsync();
        if (_notifications is not null) await _notifications.SynchronizeAsync();
    }
    private async Task<bool> CloseImportAsync()
    {
        var handled = false;
        await InvokeAsync(() =>
        {
            if (_pendingImport is null || _busy) return;
            _pendingImport = null; handled = true; StateHasChanged();
        });
        return handled;
    }
    private void RefreshNotifications() => _ = InvokeAsync(StateHasChanged);
    private async Task ChangeNotificationsAsync(ChangeEventArgs args)
    {
        _busy = true;
        try
        {
            var enabled = args.Value is true;
            if (_notifications is null) { _message = T("Settings.Message.NotificationsUnavailable"); return; }
            var success = await _notifications.SetEnabledAsync(enabled);
            _message = success ? (enabled ? T("Settings.Message.NotificationsOn") : T("Settings.Message.NotificationsOff"))
                : T("Settings.Message.NotificationsDenied");
        }
        catch (Exception exception) { _diagnostics?.Record("settings.notifications", TimeSpan.Zero, exception); _message = T("Settings.Message.NotificationsFailed"); }
        finally { _busy = false; _notificationInputRevision++; }
    }
    private void ChangeLanguage(ChangeEventArgs args)
    {
        _language?.Change(args.Value?.ToString() ?? DisplayLanguage.Auto);
        _message = "";
    }
    private Task CheckUpdatesAsync() => _updates?.CheckAsync(true) ?? Task.CompletedTask;
    private Task InstallUpdateAsync() => _updates?.InstallAsync() ?? Task.CompletedTask;
    private async Task ShareDiagnosticsAsync()
    {
        if (_diagnostics is null) return;
        _busy = true;
        try { await _diagnostics.ShareAsync(); _message = T("Settings.Message.DiagnosticsReady"); }
        catch (Exception exception) { _diagnostics.Record("diagnostics.share", TimeSpan.Zero, exception); _message = T("Settings.Message.DiagnosticsFailed"); }
        finally { _busy = false; }
    }
    public void Dispose()
    {
        if (_notifications is not null) _notifications.Changed -= RefreshNotifications;
        if (_updates is not null) _updates.Changed -= RefreshNotifications;
        _backRegistration?.Dispose();
    }
    private async Task LoadAsync()
    {
        _loading = true;
        try { await State.InitializeAsync(); _loadFailed = false; _message = ""; }
        catch { _loadFailed = true; _message = T("Settings.Message.LoadFailed"); }
        finally { _loading = false; }
    }
    private async Task ChangeGymAsync(ChangeEventArgs args)
    {
        _busy = true;
        try { var result = await State.SetGymAsync(args.Value?.ToString() ?? "One Air"); _message = result.IsSuccess ? T("Settings.Message.GymSaved") : WorkoutUi.Error(result.Error); }
        catch { _message = WorkoutUi.Error(null); }
        finally { _busy = false; }
    }
    private async Task PickImportAsync()
    {
        _busy = true;
        try { var json = await BackupFiles.PickBackupAsync(); if (json is null) return; _pendingImport = ImportBackup.Execute(json); _message = ""; }
        catch { _message = T("Settings.Message.ImportFailed"); }
        finally { _busy = false; }
    }
    private async Task ConfirmImportAsync()
    {
        if (_pendingImport is null) return;
        _busy = true;
        try
        {
            var result = await State.ReplaceDataAsync(_pendingImport);
            if (!result.IsSuccess) { _message = WorkoutUi.Error(result.Error); _pendingImport = null; return; }
            _pendingImport = null; _message = T("Settings.Message.ImportDone", State.Data.History.Count);
        }
        catch { _message = WorkoutUi.Error(null); _pendingImport = null; }
        finally { _busy = false; }
    }
    private async Task ShareBackupAsync()
    {
        _busy = true;
        try { await BackupFiles.ShareBackupAsync(ExportBackup.Execute(State.Data)); _message = T("Settings.Message.BackupReady"); }
        catch { _message = T("Settings.Message.ExportFailed"); }
        finally { _busy = false; }
    }
}
