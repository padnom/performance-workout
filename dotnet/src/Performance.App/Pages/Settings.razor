@page "/reglages"
@using Performance.Application
@using Performance.App.Services
@inject WorkoutStateService State
@inject ImportPerformanceBackupUseCase ImportBackup
@inject ExportPerformanceBackupUseCase ExportBackup
@inject IBackupFiles BackupFiles
@inject IServiceProvider Services
@implements IDisposable

<PageTitle>Réglages · Performance</PageTitle>
<p class="eyebrow">TES DONNÉES, SUR TON APPAREIL</p>
<h1>Réglages</h1>
<p class="muted intro">Sauvegarde locale, préférences et migration depuis l’application web.</p>
@if (_loading) { <p class="loading">Chargement des réglages…</p> }
@if (!string.IsNullOrEmpty(_message)) { <p class="notice" role="status">@_message</p> }
@if (!_loading && !_loadFailed)
{
    <section class="panel">
        <h2>Salle d’entraînement</h2><p class="muted">Utilisée par la séance en cours et les prochaines séances.</p>
        <label class="field">Salle
            <select value="@State.CurrentGym" disabled="@_busy" @onchange="ChangeGymAsync">
                @foreach (var gym in WorkoutUi.Gyms) { <option>@gym</option> }
            </select>
        </label>
    </section>
    <section class="panel notification-settings">
        <h2>Repos</h2>
        <label class="field"><span>Vibration de fin de repos</span>
            <input @key="_notificationInputRevision" type="checkbox" checked="@State.RestNotificationsEnabled" disabled="@_busy" @onchange="ChangeNotificationsAsync" />
        </label>
        <p class="muted">Option désactivée par défaut. Une vibration brève et une notification silencieuse te préviennent en arrière-plan ou écran éteint. Aucun son.</p>
        @if (_notifications is not null) { <p class="muted" role="status">@_notifications.Access.Description</p> }
    </section>
    <section class="panel settings-panel">
        <h2>Sauvegarde et transfert</h2>
        <p class="muted">@State.Data.History.Count séance(s) enregistrée(s). Les données restent sur cet appareil. Exporte une sauvegarde avant de changer de téléphone.</p>
        <div class="data-safety">
            <strong>Depuis l’application web</strong>
            <span>Exporte une sauvegarde complète depuis la PWA, puis sélectionne ce fichier JSON. L’import remplace les données actuelles après confirmation.</span>
        </div>
        <div class="settings-actions">
            <button class="primary-button" disabled="@_busy" @onclick="PickImportAsync">Importer une sauvegarde</button>
            <button class="secondary-button" disabled="@_busy" @onclick="ShareBackupAsync">Exporter mes données</button>
        </div>
    </section>
    <section class="panel diagnostic-settings">
        <h2>Application</h2><p class="muted">Version @(_diagnostics?.Version ?? "1.1.0 (2)")</p>
        <p class="muted">Les diagnostics contiennent les types d’erreurs et les durées des opérations, sans le contenu de tes séances. Aucun envoi automatique.</p>
        <button class="secondary-button" disabled="@(_busy || _diagnostics is null)" @onclick="ShareDiagnosticsAsync">Exporter les diagnostics</button>
    </section>
}
@if (_loadFailed) { <button class="secondary-button" @onclick="LoadAsync">Réessayer le chargement</button> }
@if (_pendingImport is { } pending)
{
    <div class="modal-backdrop">
        <section class="panel confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="import-title">
            <h2 id="import-title">Remplacer les données ?</h2>
            <p class="muted">La sauvegarde contient @pending.History.Count séance(s) et @pending.Exercises.Count exercice(s) personnalisé(s) ou modifié(s).</p>
            <p class="notice">L’historique, les exercices, les réglages et la séance en cours de cet appareil seront remplacés. Exporte tes données actuelles si tu souhaites les conserver.</p>
            <div class="settings-actions">
                <button class="primary-button" disabled="@_busy" @onclick="ConfirmImportAsync">Confirmer le remplacement</button>
                <button class="secondary-button" disabled="@_busy" @onclick="() => _pendingImport = null">Annuler</button>
            </div>
        </section>
    </div>
}

@code {
    private bool _loading = true;
    private bool _loadFailed;
    private bool _busy;
    private int _notificationInputRevision;
    private string _message = "";
    private PerformanceData? _pendingImport;
    private RestNotificationCoordinator? _notifications;
    private IAppDiagnostics? _diagnostics;
    private IDisposable? _backRegistration;
    protected override async Task OnInitializedAsync()
    {
        _notifications = Services.GetService(typeof(RestNotificationCoordinator)) as RestNotificationCoordinator;
        _diagnostics = Services.GetService(typeof(IAppDiagnostics)) as IAppDiagnostics;
        if (_notifications is not null) _notifications.Changed += RefreshNotifications;
        _backRegistration = (Services.GetService(typeof(AppNavigationService)) as AppNavigationService)?.RegisterBackHandler(CloseImportAsync, 10);
        await LoadAsync();
        if (_notifications is not null) await _notifications.SynchronizeAsync();
    }
    private async Task<bool> CloseImportAsync()
    {
        var handled = false;
        await InvokeAsync(() =>
        {
            if (_pendingImport is null || _busy) return;
            _pendingImport = null; handled = true; StateHasChanged();
        });
        return handled;
    }
    private void RefreshNotifications() => _ = InvokeAsync(StateHasChanged);
    private async Task ChangeNotificationsAsync(ChangeEventArgs args)
    {
        _busy = true;
        try
        {
            var enabled = args.Value is true;
            if (_notifications is null) { _message = "Les notifications Android ne sont pas disponibles."; return; }
            var success = await _notifications.SetEnabledAsync(enabled);
            _message = success ? (enabled ? "Notifications de repos activées." : "Notifications de repos désactivées.")
                : "Activation impossible : vérifie les autorisations Android ou réessaie la sauvegarde.";
        }
        catch (Exception exception) { _diagnostics?.Record("settings.notifications", TimeSpan.Zero, exception); _message = "Impossible de modifier les notifications de repos."; }
        finally { _busy = false; _notificationInputRevision++; }
    }
    private async Task ShareDiagnosticsAsync()
    {
        if (_diagnostics is null) return;
        _busy = true;
        try { await _diagnostics.ShareAsync(); _message = "Diagnostics prêts à être partagés."; }
        catch (Exception exception) { _diagnostics.Record("diagnostics.share", TimeSpan.Zero, exception); _message = "Impossible de partager les diagnostics."; }
        finally { _busy = false; }
    }
    public void Dispose()
    {
        if (_notifications is not null) _notifications.Changed -= RefreshNotifications;
        _backRegistration?.Dispose();
    }
    private async Task LoadAsync()
    {
        _loading = true;
        try { await State.InitializeAsync(); _loadFailed = false; _message = ""; }
        catch { _loadFailed = true; _message = "Impossible de charger les données locales. L’import et l’export restent indisponibles tant que le chargement échoue."; }
        finally { _loading = false; }
    }
    private async Task ChangeGymAsync(ChangeEventArgs args)
    {
        _busy = true;
        try { var result = await State.SetGymAsync(args.Value?.ToString() ?? "One Air"); _message = result.IsSuccess ? "Salle enregistrée." : WorkoutUi.Error(result.Error); }
        catch { _message = WorkoutUi.Error(null); }
        finally { _busy = false; }
    }
    private async Task PickImportAsync()
    {
        _busy = true;
        try { var json = await BackupFiles.PickBackupAsync(); if (json is null) return; _pendingImport = ImportBackup.Execute(json); _message = ""; }
        catch { _message = "Import impossible : le fichier n’est pas une sauvegarde Performance valide ou sa lecture a échoué. Aucune donnée n’a été remplacée."; }
        finally { _busy = false; }
    }
    private async Task ConfirmImportAsync()
    {
        if (_pendingImport is null) return;
        _busy = true;
        try
        {
            var result = await State.ReplaceDataAsync(_pendingImport);
            if (!result.IsSuccess) { _message = WorkoutUi.Error(result.Error); _pendingImport = null; return; }
            _pendingImport = null; _message = $"Import terminé : {State.Data.History.Count} séance(s) récupérée(s).";
        }
        catch { _message = WorkoutUi.Error(null); _pendingImport = null; }
        finally { _busy = false; }
    }
    private async Task ShareBackupAsync()
    {
        _busy = true;
        try { await BackupFiles.ShareBackupAsync(ExportBackup.Execute(State.Data)); _message = "Sauvegarde prête à être partagée."; }
        catch { _message = "Export impossible : la sauvegarde n’a pas pu être partagée. Réessaie."; }
        finally { _busy = false; }
    }
}
