@page "/programmes"
@using Performance.Application
@using Performance.Domain
@inject WorkoutStateService State

<PageTitle>Programmes · Performance</PageTitle>
<div class="page-heading programs-heading">
    <div><p class="eyebrow library-heading">BIBLIOTHÈQUE · @LibraryCount séances</p><h1>Choisis ta séance</h1><p class="muted">Ouvre une séance pour voir ses exercices, ou ▶&#xFE0E; pour la démarrer.</p></div>
    @if (!_loading)
    {
        <ProgramsMenu Disabled="_busy" CreateProgram="() => _editor?.Open()" CreateSession="() => _editor?.Open(singleSession: true)"
            ImportPrograms="() => _sharing?.PickAsync() ?? Task.CompletedTask" ImportSession="() => _sharing?.PickSessionAsync() ?? Task.CompletedTask"
            Export="() => _sharing?.OpenExport()" />
    }
</div>
@if (_loading) { <p class="loading" role="status">Chargement de tes données…</p> }
@if (_message.Length > 0) { <p class="notice" role="status">@_message</p> }
@if (!_loading)
{
    @if (State.Data.ActiveWorkout?.Session is { } active)
    {
        <a class="resume-workout" href="/seance"><span>Séance en cours<strong>@active.Name</strong></span><b>Reprendre la séance →</b></a>
    }
    <ProgramLibrary Snapshot="State.Data" Selected="SelectSession" Started="StartSession" Changed="Refresh" Disabled="_busy" />
    <ProgramSharing @ref="_sharing" Snapshot="State.Data" Changed="Refresh" />
    <SessionStart @ref="_starter" />
    <ProgramEditor @ref="_editor" Changed="Refresh" />
}

@code {
    private bool _loading = true;
    private bool _busy;
    private string _message = "";
    private SessionStart? _starter;
    private ProgramEditor? _editor;
    private ProgramSharing? _sharing;
    private int LibraryCount => ProgramLibrary.Groups(State).Sum(group => group.Sessions.Count);
    protected override async Task OnInitializedAsync()
    {
        try { await State.InitializeAsync(); }
        catch { _message = "Impossible de charger les données. Rouvre l’application pour réessayer."; }
        finally { _loading = false; }
    }
    private void Refresh() => StateHasChanged();
    private void SelectSession(WorkoutSession session) => Open(session, false);
    private void StartSession(WorkoutSession session) => Open(session, true);
    private void Open(WorkoutSession session, bool confirmOnly)
    {
        if (State.Data.ActiveWorkout is not null) { _message = WorkoutUi.Error("ActiveWorkoutExists"); return; }
        _starter?.Select(session, confirmOnly);
    }
}
