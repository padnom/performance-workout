<Project Sdk="Microsoft.NET.Sdk">
  <!-- Release checks run by CI and by hand: APK content, signature, version and emulator smoke test. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>performance-release</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Performance.Application/Performance.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Performance.ReleaseTools.UnitTests" />
  </ItemGroup>
</Project>
