# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (including the archived web reference)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
dist/
.wrangler/
.sites-runtime/
/outputs/
/work/

# .NET / MAUI
**/bin/
**/obj/
.vs/
.idea/
*.user
*.suo
**/TestResults/
*.apk
*.aab

# Local tooling and diagnostics
__pycache__/
*.py[cod]
*.log

# Private signing material (the public certificate fingerprint is tracked)
*.keystore
*.jks
*.pfx
*.p12
